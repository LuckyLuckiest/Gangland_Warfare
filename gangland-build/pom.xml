<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland_warfare</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>gangland-build</artifactId>
    <packaging>jar</packaging>

    <name>Gangland Build</name>

    <build>
        <directory>../target</directory>

        <plugins>
            <!-- Maven plugin shade (start) -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                    <finalName>${project.parent.artifactId}-${project.parent.version}</finalName>

                    <!-- HikariCP, XSeries and exp4j are no longer shaded (Keystone migration): Keystone.jar ships
                         them unrelocated on its classpath, so Gangland's classes resolve them from there at
                         runtime. Only Gangland-exclusive libraries remain in this jar. -->
                    <relocations>
                        <relocation>
                            <pattern>net.wesjd.anvilgui</pattern>
                            <shadedPattern>org.luckyraven.gangland.dependency.anvilgui</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>fr.mrmicky.fastboard</pattern>
                            <shadedPattern>org.luckyraven.gangland.dependency.fastboard</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>org.bstats</pattern>
                            <shadedPattern>org.luckyraven.gangland.dependency.bstats</shadedPattern>
                        </relocation>
                    </relocations>

                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludeDefaults>false</excludeDefaults>
                            <includes>
                                <!-- AnvilGUI -->
                                <include>net/wesjd/anvilgui/version/</include>
                                <!-- Project classes are discovered reflectively (beans, listeners,
                                     repositories, NMS adapters) so minimizeJar must keep them all -->
                                <include>org/luckyraven/</include>
                            </includes>
                        </filter>
                    </filters>

                    <minimizeJar>true</minimizeJar>

                    <artifactSet>
                        <includes>
                            <!-- keystone-* modules share this groupId but are provided scope, so the shade
                                 plugin never includes them — the runtime copies come from Keystone.jar. -->
                            <include>org.luckyraven:*</include>
                            <include>net.wesjd:anvilgui</include>
                            <include>fr.mrmicky:fastboard</include>
                            <include>org.bstats:*</include>
                        </includes>
                    </artifactSet>
                </configuration>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven plugin shade (end) -->
        </plugins>
    </build>

    <dependencies>
        <!-- Include Core -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-impl</artifactId>
        </dependency>

        <!-- Include NMS (MC 1.16+, matching Keystone's API floor; players on older
             clients are handled by ViaVersion/ViaBackwards) -->
        <!-- 1.21.x -->
        <dependency>
