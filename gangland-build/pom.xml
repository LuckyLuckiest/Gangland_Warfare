<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland_warfare</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>gangland-build</artifactId>
    <packaging>jar</packaging>

    <name>Gangland Build</name>

    <build>
        <directory>../target</directory>

        <plugins>
            <!-- Maven plugin shade (start) -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                    <finalName>${project.parent.artifactId}-${project.parent.version}</finalName>

                    <!-- HikariCP, XSeries and exp4j are no longer shaded (Keystone migration): Keystone.jar ships
                         them unrelocated on its classpath, so Gangland's classes resolve them from there at
                         runtime. Only Gangland-exclusive libraries remain in this jar. -->
                    <!-- AnvilGUI is NOT relocated (T-12, 2026-09-08): runtime modules ship as plain jars loaded by
                         Keystone's parent-first ModuleClassLoader and are compiled against net.wesjd.anvilgui's
                         original package name. Relocating it here only in the core jar broke every module that
                         uses AnvilGUI views (cops-n-crooks banker/trader) with a boot-time
                         NoClassDefFoundError: net/wesjd/anvilgui/AnvilGUI$StateSnapshot, because a module jar can
                         resolve AnvilGUI only by its original name from the core jar's classpath. It still ships
                         inside the core jar (see the artifactSet include and the shade filter below) - just
                         unrelocated. -->
                    <relocations>
                        <relocation>
                            <pattern>org.bstats</pattern>
                            <shadedPattern>org.luckyraven.gangland.dependency.bstats</shadedPattern>
                        </relocation>
                    </relocations>

                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludeDefaults>false</excludeDefaults>
                            <includes>
                                <!-- AnvilGUI -->
                                <include>net/wesjd/anvilgui/version/</include>
                                <!-- Project classes are discovered reflectively (beans, listeners,
                                     repositories) so minimizeJar must keep them all -->
                                <include>org/luckyraven/</include>
                            </includes>
                        </filter>
                    </filters>

                    <minimizeJar>true</minimizeJar>

                    <artifactSet>
                        <includes>
                            <!-- keystone-* modules share this groupId but are provided scope, so the shade
                                 plugin never includes them — the runtime copies come from Keystone.jar. -->
                            <include>org.luckyraven:*</include>
                            <include>net.wesjd:anvilgui</include>
                            <include>org.bstats:*</include>
                        </includes>
                        <excludes>
                            <!-- Runtime modules ship as their own jars under target/modules/ (see the
                                 maven-dependency-plugin execution below), never inside the core jar. -->
                            <exclude>org.luckyraven:gangland-mail</exclude>
                            <exclude>org.luckyraven:cops-n-crooks</exclude>
                            <exclude>org.luckyraven:gangland-gadget</exclude>
                            <exclude>org.luckyraven:gangland-turf</exclude>
                            <exclude>org.luckyraven:gangland-civilians</exclude>
                            <exclude>org.luckyraven:gangland-npc-shops</exclude>
                        </excludes>
                    </artifactSet>
                </configuration>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven plugin shade (end) -->

            <!-- Runtime modules: copied next to the core jar as target/modules/<artifact>-<version>.jar. Server
                 owners drop them into plugins/Gangland_Warfare/modules/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-modules</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <stripVersion>false</stripVersion>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.luckyraven</groupId>
                                    <artifactId>gangland-mail</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.luckyraven</groupId>
                                    <artifactId>cops-n-crooks</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.luckyraven</groupId>
                                    <artifactId>gangland-gadget</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.luckyraven</groupId>
                                    <artifactId>gangland-turf</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.luckyraven</groupId>
                                    <artifactId>gangland-civilians</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.luckyraven</groupId>
                                    <artifactId>gangland-npc-shops</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Include Core -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-impl</artifactId>
        </dependency>

        <!-- Runtime modules: provided so the reactor builds them before this module and the shade (which
             only sees compile/runtime scope) leaves them out of the core jar. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-mail</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>cops-n-crooks</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-gadget</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-turf</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-civilians</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-npc-shops</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
