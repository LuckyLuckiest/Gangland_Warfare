<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland_warfare</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>gangland-core</artifactId>

    <name>Gangland Core</name>

    <dependencies>
        <!-- Spigot Build -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Local dependencies -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <!-- WS5 G0: the identity slice (User/UserManager/Level/Bounty/Wanted, moved from gangland-domain) needs
             BeanLifecycle, the repository registry, and Keystone's economy/timer utilities. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-hooks</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publishes gangland-core's test classes as a test-jar so sibling modules can share
                 testsupport/BukkitRegistryFixture instead of each duplicating it. Test scope only —
                 nothing here ever reaches the shaded runtime jar.
                 skip=false: test-jar's skip defaults to maven.test.skip, and under -Dmaven.test.skip=true (the IDE's
                 "gangland_warfare build" run config) the jar was never made, so every module's test-scope
                 gangland-core:tests dependency failed to resolve. An empty test-jar is enough when tests are off,
                 but do not `install` with that flag: the empty jar would shadow the real one in ~/.m2 for a later
                 single-module run without -am. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
