diff --git a/gangland-features/gangland-lootchest/src/main/java/org/luckyraven/gangland/lootchest/LootChestModule.java b/gangland-features/gangland-lootchest/src/main/java/org/luckyraven/gangland/lootchest/LootChestModule.java
