+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-common</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-persistence</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>gangland-core</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-bean</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-command</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-module</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-hooks</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-item</artifactId>
+        </dependency>
+        <!-- WS3 G1/G2 (0.10.0): holograms, promoted out of Gangland's own hologram-api into Keystone. -->
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>keystone-hologram</artifactId>
+        </dependency>
+
+        <!-- ponytail: temporary — LootChestService/LootChestSession/LootChestWand*/LootChestWandListener still
+             build their shared chest view and the admin wand-preview screen on gangland-ui/inventory-api
+             (InventoryHandler, inventory.part.Fill). WS3's own G3 (owned by the CUT lead, not this stream) swaps
+             the chest view to a raw-Bukkit SharedLootInventory and the wand preview to keystone-inventory's
+             PaginatedChestMenu; this dependency and the 3 below it (only LootChestWand.java uses them) drop out
+             then, not before. -->
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>inventory-api</artifactId>
+            <scope>provided</scope>
+        </dependency>
+        <dependency>
+            <groupId>com.github.cryptomorin</groupId>
+            <artifactId>XSeries</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>de.tr7zw</groupId>
+            <artifactId>item-nbt-api-plugin</artifactId>
+        </dependency>
+        <dependency>
+            <groupId>net.wesjd</groupId>
+            <artifactId>anvilgui</artifactId>
+        </dependency>
+
+        <!-- The host API — the only host artifact a runtime module compiles against, so the compiler enforces the
+             contract. Provided: at runtime this module is loaded from plugins/Gangland_Warfare/modules/ by
+             Keystone's ModuleLoader, whose parent is the host plugin's classloader, so every api class resolves
+             from the shaded core jar. Dependency direction is module -> api; the host never names a module type. -->
+        <dependency>
+            <groupId>org.luckyraven</groupId>
+            <artifactId>gangland-api</artifactId>
+            <scope>provided</scope>
+        </dependency>
+    </dependencies>
+
+</project>
