@@ -0,0 +1,83 @@
+package org.luckyraven.keystone.testkit;
+
+import org.bukkit.Bukkit;
+import org.bukkit.Server;
+import org.bukkit.inventory.ItemFactory;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Proxy;
+import java.util.logging.Logger;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Installs a minimal real {@link Server} (via {@link Bukkit#setServer}, not a {@code mockStatic} block) so that
+ * Bukkit API which reaches {@code Bukkit.server} directly — e.g. {@code ItemStack.clone()}/{@code equals()}/
+ * {@code isSimilar()} routing through {@link Server#getItemFactory()} — works in a plain unit test.
+ * {@link BukkitStatics}'s {@code mockStatic(Bukkit.class)} does not help here: it intercepts static *method* calls,
+ * not the direct static *field* read (Bukkit's own dummy implementations read {@code Bukkit.server} straight from
+ * the field in several places). Idempotent and safe to call from any number of {@code @BeforeAll} hooks — the
+ * first caller in the fork wins, matching {@code Bukkit.setServer}'s own "settable once" contract.
+ *
+ * <p>ponytail: deliberately does not wire {@code Server#getRegistry(Class)} — that generic overload does not exist
+ * at Keystone's Spigot 1.16.5 API floor (it is a later Bukkit addition). A consumer testing against a newer Bukkit
+ * API and needing {@code Material.isAir()}/registry-backed lookups to work needs its own, newer-API fixture; this
+ * one only covers what Keystone's own floor can compile.
+ */
+public final class BukkitServerFixture {
+
+	private BukkitServerFixture() {
+	}
+
+	/** Install a mock server with a metadata-free {@link ItemFactory}, unless one is already set. */
+	public static void install() {
+		if (Bukkit.getServer() != null) {
+			return;
+		}
+
+		Server server = mock(Server.class);
+
+		// Bukkit.setServer logs a banner through these before returning.
+		when(server.getLogger()).thenReturn(Logger.getLogger("keystone-test"));
+		when(server.getName()).thenReturn("TestServer");
+		when(server.getVersion()).thenReturn("test");
+		when(server.getBukkitVersion()).thenReturn("1.16.5-R0.1-SNAPSHOT");
+
+		when(server.getItemFactory()).thenReturn(itemFactory());
+		Bukkit.setServer(server);
+	}
+
+	/**
+	 * A metadata-free {@link ItemFactory}. {@code getItemMeta} yields {@code null}, so two plain stacks of the
+	 * same type and amount compare equal — which is all {@code ItemStack.equals}/{@code isSimilar} need in a unit
+	 * test. Stacks carrying real meta are out of scope here; those belong in a server-backed test.
+	 */
+	private static ItemFactory itemFactory() {
+		InvocationHandler handler = (proxy, method, args) -> switch (method.getName()) {
+			case "getItemMeta" -> null;
+			case "equals" -> args != null && args.length == 2 ? args[0] == args[1] : proxy == (args == null ? null : args[0]);
+			case "isApplicable" -> true;
+			case "asMetaFor" -> args == null || args.length == 0 ? null : args[0];
+			case "updateMaterial" -> args == null || args.length < 2 ? null : args[1];
+			case "hashCode" -> System.identityHashCode(proxy);
+			case "toString" -> "ProxyItemFactory";
+			default -> defaultValue(method.getReturnType());
+		};
+
+		return (ItemFactory) Proxy.newProxyInstance(BukkitServerFixture.class.getClassLoader(),
+		                                            new Class<?>[]{ItemFactory.class}, handler);
+	}
+
+	/** Proxies must return a non-null value for primitive return types. */
+	private static Object defaultValue(Class<?> returnType) {
+		if (!returnType.isPrimitive()) return null;
+		if (returnType == boolean.class) return false;
+		if (returnType == void.class) return null;
+		if (returnType == char.class) return (char) 0;
+		if (returnType == long.class) return 0L;
+		if (returnType == float.class) return 0f;
+		if (returnType == double.class) return 0d;
+		return 0;
+	}
+}
