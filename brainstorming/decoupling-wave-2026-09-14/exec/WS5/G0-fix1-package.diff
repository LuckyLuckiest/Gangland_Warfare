diff --git a/gangland-infra/gangland-domain/src/test/java/org/luckyraven/gangland/gang/support/FakeIdentitySettingsContract.java b/gangland-infra/gangland-domain/src/test/java/org/luckyraven/gangland/gang/support/FakeIdentitySettingsContract.java
