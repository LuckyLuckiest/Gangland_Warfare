+package org.luckyraven.plaque.board;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.luckyravwarning: in the working copy of 'src/test/java/org/luckyraven/plaque/placeholder/PapiTextTest.java', LF will be replaced by CRLF the next time Git touches it
en.keystone.testkit.BukkitStatics;
+import org.luckyraven.plaque.board.configuration.BoardAddon;
+import org.luckyraven.plaque.config.BoardSettings;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Pins B5, the enable-time/reload board sweep: {@link BoardManager} must build and start a board for every
+ * already-online player, not only for players who join after the plugin is up. The docket risk this test guards
+ * (WS1 plan §8 row 6): "nothing in a naive join/quit-listener port would fail a build or a unit test if [the
+ * sweep is] missing, it would only show up as 'boards are missing after a restart with players online,'
+ * reported late."
+ *
+ * <p>{@code createBoard}/{@code removeBoard} are overridden to record calls instead of building a real
+ * {@code FastBoard} (which needs a live NMS server) — {@link BoardManager#sweepOnlinePlayers()} and
+ * {@link BoardManager#rebuildAll()} themselves run the real production code, which is what this test pins.
+ * {@link BoardAddon}/{@link BoardSettings} are Mockito mocks since neither is touched once {@code createBoard}
+ * is overridden away.
+ */
+@DisplayName("BoardManager - the enable-time/reload sweep must reach every already-online player (B5)")
+class BoardManagerTest {
+
+	@Test
+	@DisplayName("B5: sweepOnlinePlayers() builds a board for every already-online player")
+	void sweepOnlinePlayers_reachesEveryOnlinePlayer() {
+		try (BukkitStatics bukkit = BukkitStatics.install()) {
+			Player alice = onlinePlayer();
+			Player bob   = onlinePlayer();
+			bukkit.statics().when(Bukkit::getOnlinePlayers).thenReturn(List.of(alice, bob));
+
+			CountingBoardManager manager = countingManager();
+
+			manager.sweepOnlinePlayers();
+
+			assertEquals(List.of(alice, bob), manager.createBoardCalls);
+		}
+	}
+
+	@Test
+	@DisplayName("rebuildAll() ends every tracked board, then re-sweeps every online player (/plaque reload)")
+	void rebuildAll_killsAndRecreatesEveryOnlinePlayersBoard() {
+		try (BukkitStatics bukkit = BukkitStatics.install()) {
+			Player alice = onlinePlayer();
+			bukkit.statics().when(Bukkit::getOnlinePlayers).thenReturn(List.of(alice));
+
+			CountingBoardManager manager = countingManager();
+
+			manager.rebuildAll();
+
+			assertEquals(List.of(alice), manager.removeBoardCalls, "the existing board must be ended first");
+			assertEquals(List.of(alice), manager.createBoardCalls, "the board must be rebuilt for the still-online player");
+		}
+	}
+
+	private static CountingBoardManager countingManager() {
+		BoardAddon    boardAddon = mock(BoardAddon.class);
+		BoardSettings settings   = mock(BoardSettings.class);
+		when(settings.isEnabled()).thenReturn(true);
+
+		return new CountingBoardManager(mock(JavaPlugin.class), boardAddon, settings);
+	}
+
+	private static Player onlinePlayer() {
+		Player player = mock(Player.class);
+		when(player.getUniqueId()).thenReturn(UUID.randomUUID());
+		return player;
+	}
+
+	private static final class CountingBoardManager extends BoardManager {
+
+		private final List<Player> createBoardCalls = new ArrayList<>();
+		private final List<Player> removeBoardCalls = new ArrayList<>();
+
+		CountingBoardManager(JavaPlugin plugin, BoardAddon boardAddon, BoardSettings settings) {
+			super(plugin, (player, raw) -> raw, boardAddon, settings);
+		}
+
+		@Override
+		public void createBoard(Player player) {
+			createBoardCalls.add(player);
+		}
+
+		@Override
+		public void removeBoard(Player player) {
+			removeBoardCalls.add(player);
+		}
+
+	}
+
+}
