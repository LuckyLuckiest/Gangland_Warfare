+package org.luckyraven.keystone.inventory.flow;
+
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.inventory.InventoryService;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.Consumer;
+
+/**
+ * Fluent builder for {@link MenuFlow}. Get one via
+ * {@link MenuFlow#builder(InventoryService, JavaPlugin, Player, FlowState)}.
+ *
+ * <pre>{@code
+ * MenuFlow.<TraderFlowState>builder(inventoryService, plugin, player, new TraderFlowState(trader, player))
+ *     .panel("menu",   new TraderMenuPanel())
+ *     .panel("buy",    new TraderBuyPanel())
+ *     .panel("barter", new TraderBarterPanel())
+ *     .onEnd(state -> state.trader().releaseHold(state.buyer()))
+ *     .build()
+ *     .openAt("menu");
+ * }</pre>
+ *
+ * <p>Ported from Oriel's {@code chest.flow.MenuFlowBuilder} (commit 00b8b35) as part of Keystone Phase E6.2. No
+ * separate {@code .registry(MenuRegistry)} method — every Keystone {@code ChestMenu} requires a real
+ * {@link InventoryService} (unlike Oriel's optional {@code MenuRegistry}), and that service already carries its
+ * own {@code MenuRegistry}, so the flow just takes the service.
+ */
+public final class MenuFlowBuilder<S extends FlowState> {
+
+	private final InventoryService service;
+	private final JavaPlugin       plugin;
+	private final Player           viewer;
+	private final S                state;
+
+	private final Map<String, Panel<S>> panels = new HashMap<>();
+
+	@Nullable
+	private Consumer<S> onEnd;
+
+	MenuFlowBuilder(InventoryService service, JavaPlugin plugin, Player viewer, S state) {
+		this.service = service;
+		this.plugin  = plugin;
+		this.viewer  = viewer;
+		this.state   = state;
+	}
+
+	public MenuFlowBuilder<S> panel(String id, Panel<S> panel) {
+		panels.put(id, panel);
+		return this;
+	}
+
+	public MenuFlowBuilder<S> onEnd(Consumer<S> handler) {
+		this.onEnd = handler;
+		return this;
+	}
+
+	public MenuFlow<S> build() {
+		if (panels.isEmpty()) {
+			throw new IllegalStateException("MenuFlow needs at least one panel — call .panel(id, panel)");
+		}
+		return new MenuFlow<>(service, plugin, panels, state, viewer, onEnd);
+	}
+}
