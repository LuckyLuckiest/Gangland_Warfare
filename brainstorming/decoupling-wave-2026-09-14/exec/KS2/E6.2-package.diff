+package org.luckyraven.keystone.inventory.page;
+
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+import org.bukkit.event.inventory.ClickType;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.InventoryHolder;
+import org.bukkit.inventory.InventoryView;
+import org.bukkit.inventory.ItemFactory;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.PlayerInventory;
+import org.junit.jupiter.api.Test;
+import org.luckyraven.keystone.cooldown.CooldownService;
+import org.luckyraven.keystone.inventory.InventoryService;
+import org.luckyraven.keystone.inventory.chest.ChestMenu;
+import org.luckyraven.keystone.inventory.chest.ChestMenuBuilder;
+import org.luckyraven.keystone.testkit.BukkitStatics;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/** {@link PagedRegion}: entries render into the configured rectangular region for a given page. */
+final class PagedRegionTest {
+
+	private final InventoryService service = new InventoryService(mock(CooldownService.class));
+
+	private static Inventory fakeInventory(InventoryHolder holder, int size) {
+		ItemStack[] contents = new ItemStack[size];
+		Inventory   inv      = mock(Inventory.class);
+		when(inv.getHolder()).thenReturn(holder);
+		when(inv.getSize()).thenReturn(size);
+		when(inv.getItem(anyInt())).thenAnswer(invocation -> {
+			int idx = invocation.getArgument(0);
+			return idx >= 0 && idx < contents.length ? contents[idx] : null;
+		});
+		doAnswer(invocation -> {
+			int       idx  = invocation.getArgument(0);
+			ItemStack item = invocation.getArgument(1);
+			if (idx >= 0 && idx < contents.length) contents[idx] = item;
+			return null;
+		}).when(inv).setItem(anyInt(), any());
+		return inv;
+	}
+
+	private static BukkitStatics installBukkit() {
+		BukkitStatics bukkit = BukkitStatics.install();
+		bukkit.statics().when(Bukkit::getItemFactory).thenReturn(mock(ItemFactory.class));
+		bukkit.statics().when(() -> Bukkit.createInventory(any(InventoryHolder.class), anyInt(), anyString()))
+		      .thenAnswer(invocation -> fakeInventory(invocation.getArgument(0), invocation.getArgument(1)));
+		return bukkit;
+	}
+
+	private static Player playerNotViewingAnyMenu() {
+		Player          player = mock(Player.class);
+		when(player.getUniqueId()).thenReturn(UUID.randomUUID());
+		InventoryView   view   = mock(InventoryView.class);
+		when(player.getOpenInventory()).thenReturn(view);
+		when(view.getTopInventory()).thenReturn(mock(Inventory.class));
+		PlayerInventory inventory = mock(PlayerInventory.class);
+		when(player.getInventory()).thenReturn(inventory);
+		return player;
+	}
+
+	private static List<PagedRegion.Entry> stoneEntries(int count) {
+		List<PagedRegion.Entry> entries = new ArrayList<>();
+		for (int i = 0; i < count; i++) {
+			entries.add(new PagedRegion.Entry(new ItemStack(Material.STONE, i + 1)));
+		}
+		return entries;
+	}
+
+	@Test
+	void rendersTheFirstPageIntoTheConfiguredRegion() {
+		try (BukkitStatics bukkit = installBukkit()) {
+			// 3-row menu, region = row 1, cols 1..7 -> 7 slots/page. 10 entries -> 2 pages.
+			PageConfig               config  = PageConfig.forSize(3, 1, 1, 1, 7, 10);
+			List<PagedRegion.Entry>  entries = stoneEntries(10);
+
+			ChestMenuBuilder builder = ChestMenu.builder(service).rows(3);
+			PagedRegion.render(builder, config, entries, 0);
+			ChestMenu menu = builder.build();
+			menu.open(playerNotViewingAnyMenu());
+
+			for (int col = 1; col <= 7; col++) {
+				ItemStack item = menu.bukkitInventory().getItem(9 + col);
+				assertNotNull(item, "slot for entry " + (col - 1) + " must be filled on page 0");
+				assertEquals(col, item.getAmount()); // entries[col-1] was built with amount = col
+			}
+		}
+	}
+
+	@Test
+	void lastPageRendersTheRemainderAndLeavesTheRestUntouched() {
+		try (BukkitStatics bukkit = installBukkit()) {
+			PageConfig              config  = PageConfig.forSize(3, 1, 1, 1, 7, 10); // 7/page -> page 1 has 3 left
+			List<PagedRegion.Entry> entries = stoneEntries(10);
+
+			ChestMenuBuilder builder = ChestMenu.builder(service).rows(3);
+			PagedRegion.render(builder, config, entries, 1);
+			ChestMenu menu = builder.build();
+			menu.open(playerNotViewingAnyMenu());
+
+			assertEquals(8, menu.bukkitInventory().getItem(9 + 1).getAmount());  // entries[7]
+			assertEquals(9, menu.bukkitInventory().getItem(9 + 2).getAmount());  // entries[8]
+			assertEquals(10, menu.bukkitInventory().getItem(9 + 3).getAmount()); // entries[9]
+			assertNull(menu.bukkitInventory().getItem(9 + 4), "past the end of entries — cell stays untouched");
+		}
+	}
+
+	@Test
+	void anEntrysClickHandlerFiresOnAClickAtItsSlot() {
+		try (BukkitStatics bukkit = installBukkit()) {
+			PageConfig    config  = PageConfig.forSize(1, 0, 0, 0, 8, 1);
+			AtomicBoolean clicked = new AtomicBoolean(false);
+			List<PagedRegion.Entry> entries =
+					List.of(new PagedRegion.Entry(new ItemStack(Material.DIAMOND), ctx -> clicked.set(true)));
+
+			ChestMenuBuilder builder = ChestMenu.builder(service).rows(1);
+			PagedRegion.render(builder, config, entries, 0);
+			ChestMenu menu   = builder.build();
+			Player    player = playerNotViewingAnyMenu();
+			menu.open(player);
+
+			InventoryClickEvent event = mock(InventoryClickEvent.class);
+			when(event.getRawSlot()).thenReturn(0);
+			when(event.getClick()).thenReturn(ClickType.LEFT);
+			when(event.getCurrentItem()).thenReturn(new ItemStack(Material.DIAMOND));
+			menu.dispatchClick(event, player);
+
+			assertTrue(clicked.get());
+		}
+	}
+}
