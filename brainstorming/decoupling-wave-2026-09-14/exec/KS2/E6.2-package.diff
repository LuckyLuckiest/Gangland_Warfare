+
+	/** Suspend the flow — the close listener will not call {@link #end()} until {@link #resume()} is called. */
+	public void suspend() {
+		this.suspended = true;
+	}
+
+	/** Resume the flow after an external inventory (anvil, sign, etc.) closes. Caller follows with switchTo/openAt. */
+	public void resume() {
+		this.suspended = false;
+	}
+
+	/**
