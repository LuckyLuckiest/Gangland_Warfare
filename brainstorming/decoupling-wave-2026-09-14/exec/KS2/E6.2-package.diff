+/**
+ * Renders a slice of {@link Entry} items into a rectangular region of a {@link ChestMenuBuilder} for page
+ * {@code n}. A static utility, not a {@code Component} and not builder-integrated (unlike Oriel's
+ * {@code chest.component.PaginatedListComponent}, which this is shaped after but does not lift) — no page-state
+ * object, no {@code initialize(slotsPerPage)} registration step, no built-in previous/next button factories. The
+ * consumer owns paging state (which page is currently shown) and builds its own previous/next buttons that call
+ * back into whatever re-renders the menu (a {@code MenuFlow.rerender()}, a {@code ClickContext.rerender()}) — see
+ * {@code docs/extraction-roadmap.md} "Phase E6": "previous/next are the consumer's own buttons".
+ *
+ * <pre>{@code
+ * List<PagedRegion.Entry> entries = roster.stream()
+ *     .map(member -> new PagedRegion.Entry(memberIcon(member), ctx -> openMemberCard(ctx, member)))
+ *     .toList();
+ * PageConfig config = PageConfig.forSize(6, 1, 4, 1, 7, entries.size());
+ * ChestMenu.builder(service)
+ *     .rows(6)
+ *     .border(Material.BLACK_STAINED_GLASS_PANE)
+ *     .slot(48, ItemComponent.of(Material.ARROW).onLeftClick(ctx -> { currentPage--; ctx.rerender(); }))
+ *     .slot(50, ItemComponent.of(Material.ARROW).onLeftClick(ctx -> { currentPage++; ctx.rerender(); }));
+ * PagedRegion.render(builder, config, entries, currentPage);
+ * }</pre>
+ */
+public final class PagedRegion {
+
+	private PagedRegion() {
+	}
+
+	/**
+	 * Render {@code entries}' slice for {@code page} into {@code builder}, one explicit {@code .slot(...)} call
+	 * per occupied cell within {@code config}'s bounds. Cells past the end of {@code entries} on a partially-filled
+	 * last page are left untouched — any fill/border decoration underneath still shows through, matching
+	 * {@code ChestMenuBuilder}'s own decoration-then-explicit-slot layering. {@code page} is not range-checked
+	 * against {@link PageConfig#pageCount()} — an out-of-range page simply renders nothing (an empty page), which
+	 * the consumer's own previous/next buttons are expected to prevent by construction.
+	 */
+	public static void render(ChestMenuBuilder builder, PageConfig config, List<Entry> entries, int page) {
+		int start = page * config.slotsPerPage();
+		int index = 0;
+		for (int row = config.firstRow(); row <= config.lastRow(); row++) {
+			for (int col = config.firstCol(); col <= config.lawarning: in the working copy of 'keystone-inventory/src/test/java/org/luckyraven/keystone/inventory/flow/MenuFlowTest.java', LF will be replaced by CRLF the next time Git touches it
stCol(); col++) {
+				int entryIndex = start + index;
+				index++;
+				if (entryIndex < 0 || entryIndex >= entries.size()) continue;
+
+				Entry         entry     = entries.get(entryIndex);
+				ItemComponent component = ItemComponent.of(entry.item());
