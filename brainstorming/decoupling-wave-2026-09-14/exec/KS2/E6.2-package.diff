+package org.luckyraven.keystone.inventory.page;
+
+/**
+ * Pagination layout maths for a rectangular region of a chest menu: rows × columns → per-page slot count, page
+ * count, and how many entries actually land on the last page.
+ *
+ * <p>Default interior grid (when no explicit region override): rows {@code 1..rows-2}, cols {@code 1..7}, leaving
+ * the outer ring for borders/decorations and the bottom row for nav.
+ *
+ * <p>Reconciled from two sources (Keystone Phase E6.2, review pass 2026-09-17 finding F9): Oriel's
+ * {@code chest.internal.PageConfig} (commit 00b8b35) supplies the shape — {@code firstRow}/{@code lastRow}/
+ * {@code firstCol}/{@code lastCol}/{@code slotsPerPage}/{@code pageCount}/{@code initialPage}, and the
+ * {@link #forSize}/{@link #defaultInterior} factories, unchanged. Gangland's {@code inventory.part.PageConfig}
+ * (fields {@code maxRows}/{@code maxColumns}/{@code perPage}/{@code pages}/{@code remainingAmount}/
+ * {@code finalPage}/{@code initialPage}) contributes exactly one thing Oriel's didn't compute:
+ * {@link #remainingOnLastPage} — how many entries actually occupy the last page (Gangland's
+ * {@code remainingAmount = itemsCount - (pages - 1) * perPage}, adapted to Oriel's field names). Gangland's
+ * {@code finalPage}/{@code initialPage} fields do NOT port: in Gangland's own source both were always passed the
+ * same value ({@code MultiInventoryCreation.java:118,131} — {@code new PageConfig(..., pageSlots, pageSlots)}) and
+ * meant "the Bukkit inventory size to build for this page" under Gangland's per-page-separate-inventory model,
+ * which has no equivalent in Keystone's design (a {@link PagedRegion} pages within ONE fixed-size chest menu, never
+ * creates a differently-sized inventory per page) — porting a field two call sites never actually varied, for a
+ * model this module doesn't have, would be dead flexibility.
+ */
+public record PageConfig(int firstRow, int lastRow, int firstCol, int lastCol, int slotsPerPage, int pageCount,
+                          int initialPage, int remainingOnLastPage) {
+
+	public static PageConfig forSize(int rows, int firstRow, int lastRow, int firstCol, int lastCol, int itemCount) {
+		if (rows < 1 || rows > 6) {
+			throw new IllegalArgumentException("rows must be in [1, 6], got " + rows);
+		}
+		if (firstRow < 0 || lastRow >= rows || firstRow > lastRow) {
+			throw new IllegalArgumentException(
+					"region rows " + firstRow + ".." + lastRow + " out of range for " + rows + "-row menu");
+		}
+		if (firstCol < 0 || lastCol > 8 || firstCol > lastCol) {
+			throw new IllegalArgumentException("region cols " + firstCol + ".." + lastCol + " out of ranwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/page/PagedRegion.java', LF will be replaced by CRLF the next time Git touches it
ge");
+		}
+
+		int rowSpan      = lastRow - firstRow + 1;
+		int colSpan      = lastCol - firstCol + 1;
+		int slotsPerPage = rowSpan * colSpan;
+		int pageCount    = itemCount == 0 ? 1 : (int) Math.ceil(itemCount / (double) slotsPerPage);
+		int remainingOnLastPage = itemCount == 0 ? 0 : itemCount - (pageCount - 1) * slotsPerPage;
+
+		return new PageConfig(firstRow, lastRow, firstCol, lastCol, slotsPerPage, pageCount, 0, remainingOnLastPage);
+	}
+
+	/** Convenience constructor for the default interior grid (rows 1..rows-2, cols 1..7). */
+	public static PageConfig defaultInterior(int rows, int itemCount) {
+		int firstRow = 1;
+		int lastRow  = rows - 2;
+		// 1-row chests have no interior; clamp to row 0 so the maths still work (caller must accept the constraint).
+		if (lastRow < firstRow) {
+			firstRow = 0;
+			lastRow  = 0;
+		}
+		return forSize(rows, firstRow, lastRow, 1, 7, itemCount);
+	}
+}
