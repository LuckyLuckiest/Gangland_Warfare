+	}
+}
diff --git a/keystone-inventory/src/test/java/org/luckyraven/keystone/inventory/page/PagedRegionTest.java b/keystone-inventory/src/test/java/org/luckyraven/keystone/inventory/page/PagedRegionTest.java
