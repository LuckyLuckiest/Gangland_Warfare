+package org.luckyraven.keystone.inventory.flow;
+
+import org.luckyraven.keystone.inventory.chest.ChestMenuBuilder;
+
+/**
+ * One panel in a {@link MenuFlow}. Implementations describe how to populate a {@link ChestMenuBuilder} given the
+ * shared {@link FlowState}. {@link MenuFlow} re-invokes {@link #render(MenuFlow, ChestMenuBuilder, FlowState)}
+ * every time the panwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/page/PageConfig.java', LF will be replaced by CRLF the next time Git touches it
el is shown, so panels are stateless — all mutable state lives on {@code state}.
+ *
+ * <p>Reconciled from Oriel's {@code chest.flow.Panel} (commit 00b8b35, kept as-is — rows/title/render against a
+ * {@link ChestMenuBuilder}) and Gangland's {@code flow.Panel} (same three-method shape, but against its own
+ * {@code InventoryHandler} with a raw pixel {@code size(session)} instead of {@code rows(state)}) as part of
+ * Keystone Phase E6.2. Oriel's shape wins outright — it is the one already built against the Keystone builder
+ * type, and {@code rows} is what {@link ChestMenuBuilder#rows(int)} takes.
+ */
+public interface Panel<S extends FlowState> {
+
+	/** Number of rows for this panel's chest inventory. */
+	int rows(S state);
+
+	/** Title for this panel's chest inventory. May read state. {@code &}-coded legacy strings are accepted. */
+	String title(S state);
+
+	/** Populate the builder with components. Called every time the panel is shown. */
+	void render(MenuFlow<S> flow, ChestMenuBuilder builder, S state);
+}
