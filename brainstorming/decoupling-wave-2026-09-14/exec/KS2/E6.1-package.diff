+package org.luckyraven.keystone.inventory.registry;
+
+import lombok.CustomLog;
+import org.bukkit.entity.Player;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.inventory.tracking.NavigationHistory;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Default {@link MenuRegistry} backed by a plain map. Not thread-safe; callers run on the main server thread.
+ *
+ * <p>Ported from Oriel's {@code core.registry.InMemoryMenuRegistry} as part of Keystone Phase E6, minus the
+ * {@code ArgumentProcessorSpec}/argument-binding path and {@code registerSource}/{@code source} — see
+ * {@link MenuRegistry}'s doc.
+ */
+@CustomLog
+public class InMemoryMenuRegistry implements MenuRegistry {
+
+	private final Map<String, Supplier<Menu>> factories = new HashMap<>();
+	private final NavigationHistory           history;
+
+	/** Default constructor — owns a private {@link NavigationHistory}. Used by tests and back-compat call sites. */
+	public InMemoryMenuRegistry() {
+		this(new NavigationHistory());
+	}
+
+	/**
+	 * Construct with a shared {@link NavigationHistory} so the same trail this registry records on open is the one
+	 * the disconnect / reload listeners clear. {@code InventoryService} wires it this way;
+	 * {@link #InMemoryMenuRegistry()} is for tests.
+	 */
+	public InMemoryMenuRegistry(NavigationHistory history) {
+		this.history = history;
+	}
+
+	@Override
+	public void register(String name, Supplier<Menu> factory) {
+		factories.put(name, factory);
+	}
+
+	@Override
+	public void unregister(String name) {
+		factories.remove(name);
+	}
+
+	@Override
+	public boolean open(Player player, String name) {
+		boolean opened = doOpen(player, name);
+		if (opened) {
+			history.recordOpen(player.getUniqueId(), name);
+		}
+		return opened;
+	}
+
+	@Override
+	public boolean openPrevious(Player player) {
+		Optional<String> previous = history.back(player.getUniqueId());
+		if (previous.isEmpty()) {
+			log.debug("openPrevious for {} ignored — no previous menu in the navigation trail", player.getName());
+			return false;
+		}
+		// The navigation trail stores menu names only, so a back-nav re-opens without the original args.
+		return doOpen(player, previous.get());
+	}
+
+	private boolean doOpen(Player player, String name) {
+		Supplier<Menu> factory = factories.get(name);
+		if (factory == null) return false;
+
+		// A misbehaving factory (validator throwing on a malformed config reload, NPE in a user-supplied builder,
+		// etc.) must NOT propagate up the caller's own dispatch chain. Catch + log + return false; the caller
+		// handles "menu didn't open" as it would handle an unregistered name.
+		Menu menu;
+		try {
+			menu = factory.get();
+		} catch (RuntimeException ex) {
+			log.warn("Menu factory '{}' threw while building for {}: {}", name, player.getName(), ex.toString(), ex);
+			return false;
+		}
+		if (menu == null) return false;
+
+		try {
+			menu.open(player);
+		} catch (RuntimeException ex) {
+			log.warn("Menu '{}' threw during open() for {}: {}", name, player.getName(), ex.toString(), ex);
+			return false;
+		}
+		return true;
+	}
+
+	@Override
+	warning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/registry/MenuOpener.java', LF will be replaced by CRLF the next time Git touches it
