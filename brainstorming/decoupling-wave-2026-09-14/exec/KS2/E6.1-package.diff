+package org.luckyraven.keystone.inventory.click;
+
+import org.bukkit.event.inventory.ClickType;
+import org.junit.jupiter.api.Test;
+
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** Resolution-order contract for {@link ClickKind} — most-specific-first, always terminating at {@link ClickKind#ANY}. */
+final class ClickKindTest {
+
+	@Test
+	void shiftLeftResolvesThroughLeftToAny() {
+		assertArrayEquals(new ClickKind[] { ClickKind.SHIFT_LEFT, ClickKind.LEFT, ClickKind.ANY },
+		                   ClickKind.resolutionOrder(ClickType.SHIFT_LEFT));
+	}
+
+	@Test
+	void shiftRightResolvesThroughRightToAny() {
+		assertArrayEquals(new ClickKind[] { ClickKind.SHIFT_RIGHT, ClickKind.RIGHT, ClickKind.ANY },
+		                   ClickKind.resolutionOrder(ClickType.SHIFT_RIGHT));
+	}
+
+	@Test
+	void doubleClickDoesNotFallThrough() {
+		assertArrayEquals(new ClickKind[] { ClickKind.DOUBLE_CLICK }, ClickKind.resolutionOrder(ClickType.DOUBLE_CLICK));
+	}
+
+	@Test
+	void unrecognisedClickResolvesOnlyAny() {
+		assertArrayEquals(new ClickKind[] { ClickKind.ANY }, ClickKind.resolutionOrder(ClickType.UNKNOWN));
+	}
+
+	@Test
+	void leftAndCreativeShareTheLeftChain() {
+		assertArrayEquals(ClickKind.resolutionOrder(ClickType.LEFT), ClickKind.resolutionOrder(ClickType.CREATIVE));
+		assertTrue(java.util.Arrays.asList(ClickKind.resolutionOrder(ClickType.LEFT)).contains(ClickKind.ANY));
+	}
+
+	@Test
+	void fromYamlKeyIsCaseInsensitiveAndTrims() {
+		assertEquals(Optional.of(ClickKind.SHIFT_LEFT), ClickKind.fromYamlKey(" ON_SHIFT_LEFT_CLICK "));
+		assertEquals(Optional.empty(), ClickKind.fromYamlKey("not_a_kind"));
+		assertEquals(Optional.empty(), ClickKind.fromYamlKey(null));
+	}
+
+	@Test
+	void yamlKeyRoundTrips() {
+		for (ClickKind kind : ClickKind.values()) {
+			assertEquals(Optional.of(kind), ClickKind.fromYamlKey(kind.yamlKey()));
+		}
+	}
+
+	@Test
+	void anyHasNoBukkitType() {
+		assertEquals(Optional.empty(), ClickKind.ANY.bukkitType());
+		assertEquals(Optional.of(ClickType.LEFT), ClickKind.LEFT.bukkitType());
+	}
+}
