new file mode 100644
index 0000000..dc8b5a8
--- /dev/null
+++ b/keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/chest/ChestClickContext.java
@@ -0,0 +1,124 @@
+package org.luckyraven.keystone.inventory.chest;
+
+import org.bukkit.entity.Player;
+import org.bukkit.event.inventory.ClickType;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.inventory.ItemStack;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.inventory.click.ClickContext;
+import org.luckyraven.keystone.inventory.registry.MenuRegistry;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+
+/**
+ * Concrete {@link ClickContext}. Constructed per-click by {@linwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/chest/ChestMenu.java', LF will be replaced by CRLF the next time Git touches it
k ChestMenu}, and also reused (with slot {@code -1}
+ * and a {@code null} event) for the {@code on_open}/{@code on_close} lifecycle handlers, which have no real click
+ * to describe — {@link #cancel()} and the slot-specific behaviour already tolerate a {@code null} event, so a
+ * dedicated "headless" context class (Oriel keeps one, {@code ChestLifecycleClickContext}, for the same purpose)
+ * is not needed here.
+ *
+ * <p>Ported from Oriel's {@code chest.internal.ChestClickContext} as part of Keystone Phase E6: package-private
+ * (see {@link PassthroughPlaceholders}'s doc), and {@link #openMenu(String, String...)} is not overridden — the
+ * basic {@link MenuRegistry} does not support argument bindings, so the {@link ClickContext} interface default
+ * (ignore the args, delegate to {@link #openMenu(String)}) is exactly right.
+ */
+final class ChestClickContext implements ClickContext {
+
+	private final Player              player;
+	private final Menu                menu;
+	private final int                 slot;
+	private final ClickType           clickType;
+	private final ItemStack           clickedItem;
+	@Nullable
+	private final InventoryClickEvent event;
+	@Nullable
+	private final MenuRegistry        registry;
+
+	ChestClickContext(Player player, Menu menu, int slot, ClickType clickType, ItemStack clickedItem,
+	                  @Nullable InventoryClickEvent event, @Nullable MenuRegistry registry) {
+		this.player      = player;
+		this.menu        = menu;
+		this.slot        = slot;
+		this.clickType   = clickType;
+		this.clickedItem = clickedItem;
+		this.event       = event;
+		this.registry    = registry;
+	}
+
+	@Override
+	public Player player() {
+		return player;
+	}
+
+	@Override
+	public Menu menu() {
+		return menu;
+	}
+
+	@Override
+	public int slot() {
+		return slot;
+	}
+
+	@Override
+	public ClickType clickType() {
+		return clickType;
+	}
+
+	@Override
+	public ItemStack clickedItem() {
+		return clickedItem;
+	}
+
+	@Override
+	public boolean isShiftClick() {
+		return clickType.isShiftClick();
+	}
+
+	@Override
+	public void openMenu(String registeredName) {
+		if (registry == null) {
+			throw new IllegalStateException(
+					"openMenu(\"" + registeredName + "\") called but no MenuRegistry was attached. " +
+					"Build this menu through ChestMenu.builder(InventoryService) so ClickContext.openMenu(name) " +
+					"can route through its registry.");
+		}
+		registry.open(player, registeredName);
+	}
+
+	@Override
+	public void openPrevious() {
+		if (registry != null) registry.openPrevious(player);
+	}
+
+	@Override
+	public void closeMenu() {
+		menu.close(player);
+	}
+
+	@Override
+	public void cancel() {
+		// event is null on the lifecycle (on_open/on_close) dispatch path — nothing left to cancel there.
+		if (event != null) event.setCancelled(true);
+	}
+
+	@Override
+	public void rerender() {
+		menu.rerender();
+	}
+
+	@Override
+	public void rerenderSlot(int slot) {
+		if (menu instanceof ChestMenu cm) {
+			cm.rerenderSlot(slot);
+		} else {
+			menu.rerender();
+		}
+	}
+
+	@Override
+	public PlaceholderProvider placeholders() {
+		if (menu instanceof ChestMenu cm) return cm.placeholders();
+		return PassthroughPlaceholders.INSTANCE;
+	}
+}
