+package org.luckyraven.keystone.inventory.registry;
+
+import org.bukkit.entity.Player;
+
+/**
+ * Decoupling interface: opens a registered menu by name. {@link MenuRegistry} is the canonical implementation;
+ * tests and adapters can substitute their own without dragging the full registry along.
+ *
+ * <p>Click handlers receive a {@code ClickContext} whose {@code openMenu(String)} method delegates to the
+ * configured opener. Code that needs to open menus from a non-click pathway can take a {@link MenuOpener} directly
+ * via constructor injection.
+ *
+ * <p>Ported unchanged (bar the package) from Oriel's {@code core.registry.MenuOpener} as part of Keystone Phase E6.
+ */
