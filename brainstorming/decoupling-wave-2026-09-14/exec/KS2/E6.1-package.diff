+package org.luckyraven.keystone.inventory;
+
+/**
+ * Generic builder contract. Every menu type provides its own {@code Builder} class with type-specific methods (a
+ * {@code ChestMenuBuilder} has {@code .slot(int, ...)}; a different shape would not). Builders validate on
+ * {@link #build()}.
+ *
+ * <p>Ported from Oriel's {@code core.MenuBuilder} (menu-core) as part of Keystone Phase E6.
+ */
+public interface MenuBuilder<M extends Menu, B extends MenuBuilder<M, B>> {
+
+	M build();
+}
