+package org.luckyraven.keystone.inventory.click;
+
+/**
+ * Single-method functional interface for click handlers. Every {@code .onLeftClick(...)}, {@code .onRightClick(...)},
+ * and {@code .onAnyClick(...)} builder method ultimately accepts one of these.
+ *
+ * <p>Lambdas are the typical form. The {@link ClickContext} carries everything a handler needs; handlers do not
+ * return a value because cancellation and re-render are routed through the context, not the return type.
+ *
+ * <p>Ported unchanged (bar the package) from Oriel's {@code core.click.ClickHandler} as part of Keystone Phase E6.
+ */
+@FunctionalInterface
+public interface ClickHandler {
+
+	/** Run this handler in response to a click. */
+	void onClick(ClickContext ctx);
+}
