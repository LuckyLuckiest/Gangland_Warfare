+package org.luckyraven.keystone.inventory.click;
+
+import org.bukkit.event.inventory.ClickType;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+/**
+ * Routing semantics for {@link SlotHandlers} / {@link ClickKind} — the most-specific-first resolution and the
+ * shift-to-plain-to-any (and double-click-to-left-to-any) fall-throughwarning: in the working copy of 'keystone-inventory/src/test/java/org/luckyraven/keystone/inventory/listener/MenuListenerTest.java', LF will be replaced by CRLF the next time Git touches it
. Ported from Oriel's
+ * {@code core.click.SlotHandlersTest} as part of Keystone Phase E6.
+ */
+final class SlotHandlersTest {
+
+	private final ClickHandler left   = ctx -> { };
+	private final ClickHandler right  = ctx -> { };
+	private final ClickHandler any    = ctx -> { };
+	private final ClickHandler sleft  = ctx -> { };
+	private final ClickHandler middle = ctx -> { };
+
+	@Test
+	void exactKindWins() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.LEFT, left);
+		h.set(0, ClickKind.RIGHT, right);
+		assertSame(left, h.resolve(0, ClickType.LEFT));
+		assertSame(right, h.resolve(0, ClickType.RIGHT));
+	}
+
+	@Test
+	void shiftLeftFallsThroughToLeftThenAny() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.LEFT, left);
+		assertSame(left, h.resolve(0, ClickType.SHIFT_LEFT));
+
+		h.set(0, ClickKind.SHIFT_LEFT, sleft);
+		assertSame(sleft, h.resolve(0, ClickType.SHIFT_LEFT));
+		assertSame(left, h.resolve(0, ClickType.LEFT));
+	}
+
+	@Test
+	void doubleClickDoesNotFallThroughToLeftOrAny() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.LEFT, left);
+		h.set(0, ClickKind.ANY, any);
+		assertNull(h.resolve(0, ClickType.DOUBLE_CLICK));
+
+		ClickHandler dbl = ctx -> { };
+		h.set(0, ClickKind.DOUBLE_CLICK, dbl);
+		assertSame(dbl, h.resolve(0, ClickType.DOUBLE_CLICK));
+	}
+
+	@Test
+	void anyIsTheTerminalFallback() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.ANY, any);
+		assertSame(any, h.resolve(0, ClickType.MIDDLE));
+		assertSame(any, h.resolve(0, ClickType.DROP));
+		assertSame(any, h.resolve(0, ClickType.NUMBER_KEY));
+
+		h.set(0, ClickKind.MIDDLE, middle);
+		assertSame(middle, h.resolve(0, ClickType.MIDDLE));
+		assertSame(any, h.resolve(0, ClickType.DROP));
+	}
+
+	@Test
+	void unboundSlotResolvesNull() {
+		SlotHandlers h = new SlotHandlers();
+		assertNull(h.resolve(5, ClickType.LEFT));
+		h.set(5, ClickKind.LEFT, left);
+		h.clear(5);
+		assertNull(h.resolve(5, ClickType.LEFT));
+	}
+
+	@Test
+	void rightHasNoLeftFallback() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.LEFT, left);
+		assertNull(h.resolve(0, ClickType.RIGHT));
+	}
+
+	@Test
+	void setIfAbsentDoesNotClobber() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.ANY, any);
+		h.setIfAbsent(0, ClickKind.ANY, middle);
+		assertSame(any, h.resolve(0, ClickType.LEFT));
+	}
+
+	@Test
+	void clearAllRemovesEverySlot() {
+		SlotHandlers h = new SlotHandlers();
+		h.set(0, ClickKind.LEFT, left);
+		h.set(1, ClickKind.RIGHT, right);
+		h.clearAll();
+		assertNull(h.resolve(0, ClickType.LEFT));
+		assertNull(h.resolve(1, ClickType.RIGHT));
+	}
+}
