+package org.luckyraven.keystone.inventory.tracking;
+
+import lombok.CustomLog;
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.inventory.CloseReason;
+import org.luckyraven.keystone.inventory.Menu;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+
+/**
+ * Concrete {@link OpenMenuTracker}warning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/tracking/NavigationHistory.java', LF will be replaced by CRLF the next time Git touches it
: a concurrent {@code UUID → Menu} map plus {@link #closeAll(CloseReason)}.
+ *
+ * <p>Ported from Oriel's {@code core.registry.DefaultOpenMenuTracker} as part of Keystone Phase E6, trimmed to the
+ * tracking map itself. Two responsibilities Oriel's version carried move out:
+ * <ul>
+ *     <li>The {@code PlayerQuitEvent} listener moves to {@code MenuListener} (one class: click, drag, close,
+ *     quit) — see {@code docs/extraction-roadmap.md} Phase E6.</li>
+ *     <li>{@code BeanLifecycle.onPreClear()}/{@code onShutdown()} move to {@code InventoryService}, the
+ *     per-consumer root bean that owns this tracker — it calls {@link #closeAll(CloseReason)} with
+ *     {@link CloseReason#RELOAD}/{@link CloseReason#PLUGIN_DISABLE} from its own lifecycle hooks.</li>
+ * </ul>
+ */
+@CustomLog
+public final class DefaultOpenMenuTracker implements OpenMenuTracker {
+
+	private final ConcurrentMap<UUID, Menu> open = new ConcurrentHashMap<>();
+	@Nullable
+	private final NavigationHistory navigationHistory;
+
+	/** No-arg constructor — no navigation-history clearing. Used by tests that don't exercise "back" navigation. */
+	public DefaultOpenMenuTracker() {
+		this(null);
+	}
+
+	/**
+	 * Construct with the shared {@link NavigationHistory} so a player's back-trail is wiped when they disconnect or
+	 * the owning plugin reloads — a fresh session (or reloaded menu set) must not inherit a stale trail. The same
+	 * instance the {@code MenuRegistry} records into.
+	 */
+	public DefaultOpenMenuTracker(@Nullable NavigationHistory navigationHistory) {
+		this.navigationHistory = navigationHistory;
+	}
+
+	@Override
+	public void track(Player viewer, Menu menu) {
+		open.put(viewer.getUniqueId(), menu);
+	}
+
+	@Override
+	public void untrack(Player viewer) {
+		open.remove(viewer.getUniqueId());
+	}
+
+	@Override
+	@Nullable
+	public Menu currentMenuOf(Player viewer) {
+		return open.get(viewer.getUniqueId());
+	}
+
+	@Override
+	public Set<UUID> currentViewers() {
+		return Collections.unmodifiableSet(open.keySet());
+	}
+
+	@Override
+	public void closeAll(CloseReason reason) {
+		// Snapshot first, then clear — so any listener that fires as a side-effect of close() sees an empty map
+		// and treats the close as already-untracked. Iterating after clear avoids ConcurrentModificationException
+		// for any handler that calls untrack() or open() mid-loop.
+		Map<UUID, Menu> snapshot = new HashMap<>(open);
+		open.clear();
+		if (navigationHistory != null) {
+			// Reload / disable wipes every menu — the navigation trails go with them so a post-reload open starts clean.
+			snapshot.keySet().forEach(navigationHistory::clear);
+		}
+
+		for (Map.Entry<UUID, Menu> entry : snapshot.entrySet()) {
+			Player player = Bukkit.getPlayer(entry.getKey());
+			if (player == null) continue;     // already gone — close is a no-op for offline players
+			try {
+				entry.getValue().close(player, reason);
+			} catch (Exception ex) {
+				log.warn("Menu close failed for {} (reason={}): {}", player.getName(), reason, ex.toString(), ex);
+			}
+		}
+	}
+
+	/** The shared {@link NavigationHistory}, or {@code null} if this tracker was built without one. */
+	@Nullable
+	public NavigationHistory navigationHistory() {
+		return navigationHistory;
+	}
+}
