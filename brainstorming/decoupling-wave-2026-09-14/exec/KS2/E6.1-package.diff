+package org.luckyraven.keystone.inventory.spi;
+
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.InventoryHolder;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.inventory.InventoryService;
+
+/**
+ * Bukkit {@link InventoryHolder} that back-references the owning menu ({@link MenuTarget}) AND the
+ * {@link InventoryService} that created it. {@code MenuListener} identifies a Keystone-owned inventory by
+ * {@code getHolder() instanceof MenuHolder}, and — critically, since the shared classloader means Oriel's and
+ * Gangland's {@code MenuListener} instances both see every click event — filters by {@code holder.service() == this.service}
+ * so a click on Oriel's menu never reaches Gangland's listener and vice versa (each consumer's {@link InventoryService}
+ * is its own instance; no static registry, per {@code CLAUDE.md}'s shared-classloader constraint).
+ *
+ * <p>Construction is necessarily two-step: holder first (Bukkit needs it at inventory create time), then the menu,
+ * then {@link #setTarget(MenuTarget)} to close the loop.
+ *
+ * <p>Ported from Oriel's {@code chest.internal.ChestMenuHolder} as part of Keystone Phase E6, with the owning
+ * {@link InventoryService} added.
+ */
+public final class MenuHolder implements InventoryHolder {
+
+	private final InventoryService service;
+	@Nullable
+	private MenuTarget target;
+
+	public MenuHolder(InventoryService service) {
+		this.service = service;
+	}
+
+	/** The {@link InventoryService} this holder's menu belongs to. See the class doc for why identity needs this. */
+	public InventoryService service() {
+		return service;
+	}
+
+	@Nullable
+	public MenuTarget target() {
+		return target;
+	}
+
+	public void setTarget(MenuTarget target) {
+		this.target = target;
+	}
+
+	@Override
+	@Nullable
+	public Inventory getInventory() {
+		return target == null ? null : target.bukkitInventory();
+	}
+}
