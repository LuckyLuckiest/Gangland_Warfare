+package org.luckyraven.keystone.inventory.chest;
+
+import org.bukkit.entity.Player;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.inventory.component.RenderContext;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+
+/**
+ * Concrete {@link RenderContext}. Carries the player, menu, placeholder provider, and tick through every render
+ * call.
+ *
+ * <p>Ported unchanged (bar the package, and package-private — see {@link PassthroughPlaceholders}'s doc) from
+ * Oriel's {@code chest.internal.ChestRenderContext} as part of Keystone Phase E6.
+ */
+final class ChestRenderContext implements RenderContext {
+
+	private final Player              player;
+	private final Menu                menu;
+	private final PlaceholderProvider placeholders;
+	private final int                 tick;
+
+	ChestRenderContext(Player player, Menu menu, PlaceholderProvider placeholders) {
+		this(player, menu, placeholders, 0);
+	}
+
+	ChestRenderContext(Player player, Menu menu, PlaceholderProvider placeholders, int tick) {
+		this.player       = player;
+		this.menu         = menu;
+		this.placeholders = placeholders;
+		this.tick         = tick;
+	}
+
+	@Override
+	public Player player() {
+		return player;
+	}
+
+	@Override
+	public Menu menu() {
+		return menu;
+	}
+
+	@Override
+	public PlaceholderProvider placeholders() {
+		return placeholders;
+	}
+
+	@Override
+	public int tick() {
+		return tick;
+	}
+}
