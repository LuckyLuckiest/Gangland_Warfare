+
+	public ItemComponent onLeftClick(ClickHandler handler) {
+		this.left = handler;
+		return this;
+	}
+
+	public ItemComponent onRightClick(ClickHandler handler) {
+		this.right = handler;
+		return this;
+	}
+
+	public ItemComponent onAnyClick(ClickHandler handler) {
+		this.any = handler;
+		return this;
+	}
+
+	public ItemComponent onMiddleClick(ClickHandler handler) {
+		this.middle = handler;
+		return this;
+	}
+
+	public ItemComponent onShiftLeftClick(ClickHandler handler) {
+		this.shiftLeft = handler;
+		return this;
+	}
+
+	public ItemComponent onShiftRightClick(ClickHandler handler) {
+		this.shiftRight = handler;
+		return this;
+	}
+
+	public ItemComponent onDrop(ClickHandler handler) {
+		this.drop = handler;
+		return this;
+	}
+
+	public ItemComponent onNumberKey(ClickHandler handler) {
+		this.numberKey = handler;
+		return this;
+	}
+
+	public ItemComponent onDoubleClick(ClickHandler handler) {
+		this.doubleClick = handler;
+		return this;
+	}
+
+	@Override
+	public void renderInto(SlotView view, RenderContext ctx) {
+		view.setItem(item);
+		view.interactive(interactive);
+		if (left != null) view.onLeftClick(left);
+		if (right != null) view.onRightClick(right);
+		if (any != null) view.onAnyClick(any);
+		if (middle != null) view.onMiddleClick(middle);
+		if (shiftLeft != null) view.onShiftLeftClick(shiftLeft);
+		if (shiftRight != null) view.onShiftRightClick(shiftRight);
+		if (drop != null) view.onDrop(drop);
+		if (numberKey != null) view.onNumberKey(numberKey);
+		if (doubleClick != null) view.onDoubleClick(doubleClick);
+	}
+}
