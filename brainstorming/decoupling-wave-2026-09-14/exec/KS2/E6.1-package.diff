+package org.luckyraven.keystone.inventory;
+
+/**
+ * Why a {@link Menu} is being closed. Passed to {@link Menu#close(org.bukkit.entity.Player, CloseReason)} so
+ * implementations can branch on the cause — e.g. return held items only when the close was non-user-initiated.
+ *
+ * <p>Implementations that don't care about the reason can keep using the legacy
+ * {@link Menu#close(org.bukkit.entity.Player)} — the default {@link Menu#close(org.bukkit.entity.Player, CloseReason)}
+ * delegates to it so all callers stay compatible.
+ *
+ * <p>Ported from Oriel's {@code core.CloseReason} (menu-core) as part of Keystone Phase E6.
+ */
+public enum CloseReason {
+
+	/** Player closed the menu themselves (Esc, clicking outside, opening another inventory). */
+	USER,
+
+	/** A programmatic {@code menu.close()} / consumer action fired the close. */
+	COMMAND,
+
+	/** A {@code MenuFlow} switched panels or ended; the previous panel's inventory is being torn down. */
+	NAVIGATION,
+
+	/** Plugin {@code onDisable} — server stopping, /reload, or this plugin specifically being disabled. */
+	PLUGIN_DISABLE,
+
+	/** Bean-lifecycle reload cycle — {@code InventoryService.onPreClear()} rebuilding registerewarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/InventoryService.java', LF will be replaced by CRLF the next time Git touches it
warning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/Menu.java', LF will be replaced by CRLF the next time Git touches it
d menus. */
+	RELOAD,
+
+	/** The viewing player disconnected from the server while the menu was open. */
+	PLAYER_DISCONNECT,
+
+	/** Fallback for closes that didn't pipe through the tracker (third-party plugin, NMS, etc.). */
+	UNKNOWN
+}
