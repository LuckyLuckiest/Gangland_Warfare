+package org.luckyraven.keystone.inventory.spi;
+
+import org.bukkit.entity.Player;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryCloseEvent;
+import org.bukkit.inventory.Inventory;
+import org.luckyraven.keystone.inventory.click.ClickHandler;
+import org.luckyraven.keystone.inventory.click.ClickKind;
+
+/**
+ * The seam every concrete menu type implements so {@link MenuHolder} and {@code MenuListener} can drive it without
+ * knowing its concrete class. Merges Oriel's {@code chest.internal.OrielMenuTarget} and
+ * {@code chest.internal.SlotHandlerSink} into one interface (Keystone ships only one menu shape, {@code ChestMenu},
+ * so the two-interface split Oriel needed for its chest + paginated-chest pair collapses to one).
+ *
+ * <p>Ported from Oriel's {@code chest.internal.OrielMenuTarget}/{@code SlotHandlerSink} as part of Keystone Phase
+ * E6, with two changes:
+ * <ul>
+ *     <li>{@link #isInteractive(int)}/{@link #setInteractive(int, boolean)} are new — Gangland's per-slot
+ *     "draggable" flag, folded in. {@code MenuListener} consults {@link #isInteractive(int)} to decide whether to
+ *     cancel a top-inventory click by default.</li>
+ *     <li>Oriel's three finer deposit-routing defaults ({@code componentAt}, {@code findAcceptingDepositSlot},
+ *     {@code dispatchDeposit}) collapse into one — {@link #handleDepositClick(InventoryClickEvent)} — per the E6
+ *     plan review (finding F1): Oriel's own deposit-slot place/pickup/swap/shift-transfer logic (~130 lines) does
+ *     not compile against a finer swarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/tracking/DefaultOpenMenuTracker.java', LF will be replaced by CRLF the next time Git touches it
eam, so the whole branch stays inside Oriel's own {@code MenuTarget}
+ *     implementation behind this one hook. {@code MenuListener} calls it for both a direct click on a menu slot and
+ *     a shift-click from the player's own inventory; a {@code true} return means the implementation fully handled
+ *     the event (including any {@code event.setCancelled(...)} it needed) and {@code MenuListener} does nothing
+ *     further for that click.</li>
+ * </ul>
+ */
+public interface MenuTarget {
+
+	Inventory bukkitInventory();
+
+	/** Bind {@code handler} for {@code kind} on {@code slot}. Routing across kinds lives in the menu's SlotHandlers. */
+	void setHandler(int slot, ClickKind kind, ClickHandler handler);
+
+	void clearHandlers(int slot);
+
+	/** Cancel-by-default has already happened in the listener. Resolve and invoke the slot's click handler. */
+	void dispatchClick(InventoryClickEvent event, Player player);
+
+	/**
+	 * Menu-level {@code click_delay} anti-spam debounce in milliseconds, mirroring {@code Menu.clickDelayMillis()}
+	 * so the listener can read it through this interface without a concrete cast. {@code 0} (default) disables it.
+	 */
+	default int clickDelayMillis() {
+		return 0;
+	}
+
+	/** Called once the player closes the inventory. Default is a no-op; override for cleanup hooks. */
+	default void onClose(InventoryCloseEvent event, Player player) {
+	}
+
+	/**
+	 * Whether a player-initiated close of this menu should be undone. Consulted by {@code MenuListener} before
+	 * untracking; when {@code true} the listener re-opens the menu next tick (Bukkit close events can't be
+	 * cancelled) and skips the {@link #onClose} dispatch. Default: closes always stand.
+	 */
+	default boolean vetoesClose(Player player) {
+		return false;
+	}
+
+	/**
+	 * Whether {@code slot} is interactive — the click there is not cancelled-by-default. Default {@code false}: a
+	 * menu type that never calls {@link #setInteractive(int, boolean)} behaves exactly as every menu always did
+	 * (cancel-by-default on every top-inventory slot).
+	 */
+	default boolean isInteractive(int slot) {
+		return false;
+	}
+
+	/**
+	 * Mark {@code slot} interactive (or not). Written by {@code ChestSlotView.interactive(boolean)} during render,
+	 * and pre-seeded by {@code ChestMenuBuilder.interactive(int)} at build time. Default no-op for menu types that
+	 * don't support the flag.
+	 */
+	default void setInteractive(int slot, boolean interactive) {
+	}
+
+	/**
+	 * Give this menu type a chance to fully handle a click that needs special item-routing (a deposit slot, in
+	 * Oriel's case) before the listener applies its generic cancel/interactive/dispatch policy. Called for both a
+	 * click landing in the menu's own inventory and a shift-click originating in the player's inventory. A
+	 * {@code true} return means the implementation already did everything the click needed (including cancelling
+	 * the event if required); {@code false} (the default) means "not my concern, apply the normal policy".
+	 */
+	default boolean handleDepositClick(InventoryClickEvent event) {
+		return false;
+	}
+}
