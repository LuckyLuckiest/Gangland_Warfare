+/**
+ * Click/drag routing policy for {@link MenuListener}: holder identity (including the two-service case), the
+ * cancel/interactive/bottom-inventory/drag matrix, and the debounce gate. Ported in spirit from Oriel's
+ * {@code chest.listener.ChestMenuClickListener} tests as part of Keystone Phase E6; the identity and interactive
+ * flag are new (Keystone owns basic click routing across two independently-instantiated consumers now).
+ */
+final class MenuListenerTest {
+
+	private final CooldownService cooldowns = mock(CooldownService.class);
+	private final JavaPlugin      plugin    = mock(JavaPlugin.class);
+
+	private InventoryService newService() {
+		return new InventoryService(cooldowns);
+	}
+
+	private Inventory topInventory(MenuHolder holder, int size) {
+		Inventory inv = mock(Inventory.class);
+		when(inv.getHolder()).thenReturn(holder);
+		when(inv.getSize()).thenReturn(size);
+		return inv;
+	}
+
+	private InventoryClickEvent clickEvent(Inventory topInventory, Inventory clickedInventory, int rawSlot,
+	                                       Player player) {
+		InventoryClickEvent event = mock(InventoryClickEvent.class);
+		when(event.getInventory()).thenReturn(topInventory);
+		when(event.getClickedInventory()).thenReturn(clickedInventory);
+		when(event.getRawSlot()).thenReturn(rawSlot);
+		when(event.getWhoClicked()).thenReturn(player);
+		return event;
+	}
+
+	// --- Holder identity, including the two-service case ---------------------------------------------------
+
+	@Test
+	void twoServiceCase_onlyTheMatchingServiceDispatches() {
