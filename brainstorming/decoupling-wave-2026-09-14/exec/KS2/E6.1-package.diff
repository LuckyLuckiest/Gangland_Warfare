@@ -0,0 +1,29 @@
+package org.luckyraven.keystone.inventory.component;
+
+/**
+ * A render unit. Components describe what to put in a slot and how to react to clicks; the menu places them at
+ * positions. Standard implementations shipped with {@code inventory.chest} include {@code ItemComponent},
+ * {@code FillComponent}, {@code BorderComponent} and {@code LineComponent}.
+ *
+ * <p>Custom components implement this interface directly and are used through the same builder methods as the
+ * built-ins — there is no privileged set.
+ *
+ * <pre>{@code
+ * public final class CountdownComponent implements Component<CountdownComponent> {
+ *     public void renderInto(SlotView view, RenderContext ctx) {
+ *         view.setItem(new ItemStack(Material.CLOCK));
+ *     }
+ * }
+ * }</pre>
+ *
+ * <p>Ported from Oriel's {@code core.component.Component} as part of Keystone Phase E6. Oriel's reactive
+ * {@code dependencies()}/{@code DependencyKey} re-render mechanism stays in Oriel as a subtype — it is an advanced
+ * feature, not part of the basic mechanism.
+ *
+ * @param <T> self-type for fluent builder methods on subclasses
+ */
+public interface Component<T extends Component<T>> {
+
+	/** Render this component into the given slot view. Called once per render pass. */
+	void renderInto(SlotView view, RenderContext ctx);
+}
