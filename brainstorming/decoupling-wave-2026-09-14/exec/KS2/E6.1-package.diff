@@ -0,0 +1,65 @@
+package org.luckyraven.keystone.inventory.click;
+
+import org.bukkit.event.inventory.ClickType;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Per-slot click-handler storage shared by every menu type. Menus delegate their {@code SlotView} writes and their
+ * click-dispatch lookups here, so the most-specific-first {@link ClickKind} routing lives in exactly one place
+ * ({@link #resolve}).
+ *
+ * <p>Not thread-safe; all access is on the main server thread, as with the menus that own an instance.
+ *
+ * <p>Ported unchanged (bar the package) from Oriel's {@code core.click.SlotHandlers} as part of Keystone Phase E6.
+ */
+public final class SlotHandlers {
+
+	private final Map<Integer, EnumMap<ClickKind, ClickHandler>> bySlot = new HashMap<>();
+
+	/** Bind {@code handler} to {@code kind} on {@code slot}, replacing any handler already bound to that kind. */
+	public void set(int slot, ClickKind kind, ClickHandler handler) {
+		bySlot.computeIfAbsent(slot, k -> new EnumMap<>(ClickKind.class)).put(kind, handler);
+	}
+
+	/**
+	 * Bind {@code handler} to {@code kind} on {@code slot} only if that kind has no handler yet — used for default
+	 * controls that should not clobber a user-supplied handler on the same slot.
+	 */
+	public void setIfAbsent(int slot, ClickKind kind, ClickHandler handler) {
+		bySlot.computeIfAbsent(slot, k -> new EnumMap<>(ClickKind.class)).putIfAbsent(kind, handler);
+	}
+
+	/** Remove every handler bound to {@code slot}. */
+	public void clear(int slot) {
+		bySlot.remove(slot);
+	}
+
+	/** Remove every handler on every slot. */
+	public void clearAll() {
+		bySlot.clear();
+	}
+
+	/**
+	 * Resolve the handler for a click of {@code type} on {@code slot}, trying each kind in
+	 * {@link ClickKind#resolutionOrder} until one is bound. Returns {@code null} if the slot has no matching
+	 * handler.
+	 */
+	@Nullable
+	public ClickHandler resolve(int slot, ClickType type) {
+		EnumMap<ClickKind, ClickHandler> map = bySlot.get(slot);
+		if (map == null) {
+			return null;
+		}
+		for (ClickKind kind : ClickKind.resolutionOrder(type)) {
+			ClickHandler handler = map.get(kind);
+			if (handler != null) {
+				return handler;
+			}
+		}
+		return null;
+	}
+}
