;
+
+import org.bukkit.entity.Player;
+
+/**
+ * Base contract for any menu. Each menu type (chest, and whatever a consumer builds on top) extends this with
+ * type-appropriate methods via its own builder; the slot shape is not generalised across types.
+ *
+ * <p>Most code holds a concrete subtype reference and only sees this interface when crossing module boundaries
+ * (the registry, the open-menu tracker, etc.). End-users build menus through their builder and call
+ * {@link #open(Player)}; the rest of the contract is for framework code that needs to drive a menu without knowing
+ * its concrete type.
+ *
+ * <p>Ported from Oriel's {@code core.Menu} (menu-core) as part of Keystone Phase E6 — see
+ * {@code docs/extraction-roadmap.md} "Phase E6 — keystone-inventory". {@code bindArguments} is deliberately not
+ * carried over: command-argument bindings are Oriel's advanced feature, not Keystone's basic mechanism.
+ */
+public interface Menu {
+
+	/** Open this menu for the given player. Implementations are responsible for tracking open instances. */
+	void open(Player player);
+
+	/** Close this menu for the given player. No-op if the player has not opened this menu. */
+	void close(Player player);
+
+	/**
+	 * Close this menu, with a reason describing why. Default delegates to {@link #close(Player)} for back-compat —
+	 * implementations that need to react to the close cause (item-return on shutdown, persistence on reload,
+	 * different feedback per reason) override this.
+	 *
+	 * <p>The {@code OpenMenuTracker} infrastructure routes every disconnect / reload / plugin-disable through this
+	 * overload so menus that hold real player items can return them before Bukkit blanket-closes the inventory.
+	 */
+	default void close(Player player, CloseReason reason) {
+		close(player);
+	}
+
+	/** Re-renders every slot. */
+	default void rerender() {
+	}
+
+	/**
+	 * Menu-level {@code click_delay} anti-spam debounce, in milliseconds. {@code 0} (the default) disables it. A
+	 * menu type's click listener consults this through {@code ClickDebounce} and silently swallows clicks that land
+	 * inside the window. Types that support it override; the rest inherit the no-debounce default.
+	 */
+	default int clickDelayMillis() {
+		return 0;
+	}
+}
