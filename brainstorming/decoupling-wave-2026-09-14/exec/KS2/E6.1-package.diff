+package org.luckyraven.keystone.inventory.component;
+
+import org.bukkit.inventory.ItemStack;
+import org.luckyraven.keystone.inventory.click.ClickHandler;
+
+/**
+ * Narrow write-side surface a {@link Component} uses to set its item, click handlers, and interactive flag.
+ * Components only see this, not the full menu, so they cannot mutate other slots or the menu structure during
+ * render.
+ *
+ * <p>Ported from Oriel's {@code core.component.SlotView} as part of Keystone Phase E6, with one addition:
+ * {@link #interactive(boolean)} — Gangland's per-slot "draggable" flag, folded in from
+ * {@code gangland-ui/inventory-api}. A slot marked interactive is not click-cancelled by {@code MenuListener}, so
+ * the player can freely place/pick up items there (an input/output slot); a slot left non-interactive (the
+ * default) is cancelled-by-default, as every menu slot always was.
+ */
+public interface SlotView {
+
+	void setItem(ItemStack item);
+
+	void onLeftClick(ClickHandler handler);
+
+	void onRightClick(ClickHandler handler);
+
+	void onAnyClick(ClickHandler handler);
+
+	/**
+	 * Bind a handler for a middle-click. Default no-op: a {@link SlotView} that does not support the broadened
+	 * click set silently drops it (the slot still works for left / right / any).
+	 */
+	default void onMiddleClick(ClickHandler handler) {
+	}
+
+	/** Bind a handler for a shift+left-click. Falls through to the left handler if unset. Default no-op. */
+	default void onShiftLeftClick(ClickHandler handler) {
+	}
+
+	/** Bind a handler for a shift+right-click. Falls through to the right handler if unset. Default no-op. */
+	default void onShiftRightClick(ClickHandler handler) {
+	}
+
+	/** Bind a handler for a drop (Q / Ctrl+Q while hovering the slot). Default no-op. */
+	default void onDrop(ClickHandler handler) {
+	}
+
+	/** Bind a handler for a hotbar number-key swap on the slot. Default no-op. */
+	default void onNumberKey(ClickHandler handler) {
+	}
+
+	/** Bind a handler for a double-click. Falls through to the left handler if unset. Default no-op. */
+	default void onDoubleClick(ClickHandler handler) {
+	}
+
+	void clearHandlers();
+
+	/**
+	 * Mark this slot as interactive (or not) for the current render. An interactive slot's click is not
+	 * cancelled-by-default by {@code MenuListener} — the player can place/pick up items there. Default is a
+	 * no-op: a {@link SlotView} that doesn't back onto a {@code MenuTarget} (a headless test double, say) simply
+	 * ignores it.
+	 */
+	default void interactive(boolean interactive) {
+	}
+}
