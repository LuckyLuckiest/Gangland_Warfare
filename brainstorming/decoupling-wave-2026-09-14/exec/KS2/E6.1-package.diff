+import org.luckyraven.keystone.cooldown.ClickDebounce;
+import org.luckyraven.keystone.cooldown.CooldownService;
+import org.luckyraven.keystone.inventory.CloseReason;
+import org.luckyraven.keystone.inventory.InventoryService;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.inventory.spi.MenuHolder;
+import org.luckyraven.keystone.inventory.spi.MenuTarget;
+import org.luckyraven.keystone.inventory.tracking.DefaultOpenMenuTracker;
+
+/**
+ * Global click/drag/close/quit listener for every menu inventory owned by one {@link InventoryService}. Keystone
+ * ships this class but never registers it — {@link InventoryService#registerListeners(JavaPlugin)} does that once
+ * per consumer, at bootstrap.
+ *
+ * <p>Ported from Oriel's {@code chest.listener.ChestMenuClickListener} + {@code ChestMenuCloseListener} +
+ * the {@code PlayerQuitEvent} handler that lived on {@code core.registry.DefaultOpenMenuTracker} — one class here,
+ * per the E6 plan.
+ *
+ * <p><b>Identity.</b> {@code event.getInventory().getHolder() instanceof MenuHolder holder && holder.service() == this.service}.
+ * The shared classloader means every consumer's {@code MenuListener} sees every click on every menu inventory on
+ * the server, Oriel's and Gangland's alike; the service-identity check is what makes exactly one of them dispatch
+ * a given click. See {@link MenuHolder}'s doc.
+ *
+ * <p><b>Click policy</b> (merged from both of Oriel's listeners, plus the new interactive-slot flag folded in from
+ * Gangland): a click landing in the menu's own inventory first gets a chance at
+ * {@link MenuTarget#handleDepositClick(InventoryClickEvent)} — Oriel's deposit-slot place/pickup/swap logic lives
+ * entirely behind that one hook (finding F1 of the E6 plan review); if it declines, the slot is cancelled unless
+ * {@link MenuTarget#isInteractive(int)}, then {@link ClickDebounce} gates on {@link MenuTarget#clickDelayMillis()},
+ * then {@link MenuTarget#dispatchClick(InventoryClickEvent, Player)} resolves and invokes the slot's handler. A
+ * click in the player's own (bottom) inventory passes through untouched unless it is
+ * {@link InventoryAction#COLLECT_TO_CURSOR} (always blocked) or a shift-click (routed through
+ * {@link MenuTarget#handleDepositClick(InventoryClickEvent)}, blocked if declined). A drag is cancelled if any of
+ * its slots land in the menu's inventory and are not interactive.
+ */
+@CustomLog
+public final class MenuListener implements Listener {
+
+	private final InventoryService service;
+	private final JavaPlugin       plugin;
+	private final CooldownService  cooldowns;
+
+	public MenuListener(InventoryService service, JavaPlugin plugin, CooldownService cooldowns) {
+		this.service   = service;
+		this.plugin    = plugin;
+		this.cooldowns = cooldowns;
+	}
+
+	@EventHandler
+	public void onClick(InventoryClickEvent event) {
+		MenuHolder holder = ownHolder(event.getInventory());
+		if (holder == null) return;
+		MenuTarget target = holder.target();
+		if (target == null) return;
+
+		if (event.getClickedInventory() != event.getInventory()) {
+			handlePlayerInventoryClick(event, target);
+			return;
+		}
+
+		if (target.handleDepositClick(event)) return;
+
+		int slot = event.getRawSlot();
+		if (!target.isInteractive(slot)) {
+			event.setCancelled(true);
+		}
+
+		Player player = (Player) event.getWhoClicked();
+		if (ClickDebounce.shouldSwallow(cooldowns, player, target.clickDelayMillis())) return;
+		target.dispatchClick(event, player);
+	}
+
+	/**
+	 * Click in the player's own inventory while a menu is open. A shift-click can route an item into a
+	 * consumer-owned deposit slot via {@link MenuTarget#handleDepositClick(InventoryClickEvent)}; a plain click
+	 * passes through untouched, except {@link InventoryAction#COLLECT_TO_CURSOR} which is always blocked because
+	 * it would pull from the menu's own slots.
+	 */
+	private void handlePlayerInventoryClick(InventoryClickEvent event, MenuTarget target) {
+		if (event.getAction() == InventoryAction.COLLECT_TO_CURSOR) {
+			event.setCancelled(true);
+			return;
+		}
+		if (!event.isShiftClick()) {
+			return;
+		}
+		ItemStack source = event.getCurrentItem();
+		if (source == null || source.getType() == Material.AIR || source.getAmount() <= 0) {
+			event.setCancelled(true);
+			return;
+		}
+		if (!target.handleDepositClick(event)) {
+			// No consumer-specific routing accepted the shift-transfer — block it so the player doesn't
+			// accidentally inject items into non-deposit slots.
+			event.setCancelled(true);
+		}
+	}
+
+	@EventHandler
+	public void onDrag(InventoryDragEvent event) {
+		MenuHolder holder = ownHolder(event.getInventory());
+		if (holder == null) return;
+		MenuTarget target = holder.target();
+		if (target == null) return;
+
+		int topSize = event.getInventory().getSize();
+		for (int rawSlot : event.getRawSlots()) {
+			if (rawSlot < topSize && !target.isInteractive(rawSlot)) {
+				event.setCancelled(true);
+				return;
+			}
+		}
+	}
+
+	@EventHandler
+	public void onClose(InventoryCloseEvent event) {
+		MenuHolder holder = ownHolder(event.getInventory());
+		if (holder == null) return;
+		MenuTarget target = holder.target();
+		if (target == null) return;
+
+		Player player = (Player) event.getPlayer();
+
+		// Only untrack (and only consult the close gate) if this menu is still the tracked one. When a navigation
+		// opens a new inventory while one is already open, the incoming menu's open() tracks itself before
+		// player.openInventory() runs, which causes Bukkit to fire this close event for the OLD inventory after
+		// the new one is already registered — skipping in that case preserves the new registration and keeps a
+		// menu-to-menu transition from being vetoed by the outgoing menu's own close gate.
+		if (service.tracker().currentMenuOf(player) == target) {
+			if (target instanceof Menu menu && target.vetoesClose(player)) {
+				// Untrack now — open() re-tracks, and if the re-open's own gate aborts, the player must not stay
+				// tracked against a closed inventory. onClose is NOT dispatched: a vetoed close never "happened".
+				service.tracker().untrack(player);
+				Bukkit.getScheduler().runTask(plugin, () -> {
+					if (player.isOnline()) {
+						menu.open(player);
+					}
+				});
+				return;
+			}
+			service.tracker().untrack(player);
+		}
+		target.onClose(event, player);
+	}
+
+	@EventHandler(priority = EventPriority.LOWEST, ignoreCancelled = false)
+	public void onQuit(PlayerQuitEvent event) {
+		Player viewer = event.getPlayer();
+		// Clear the back-trail regardless of whether a menu was open — a disconnect always ends the navigation
+		// session for this service.
+		if (service.tracker() instanceof DefaultOpenMenuTracker tracker && tracker.navigationHistory() != null) {
+			tracker.navigationHistory().clear(viewer.getUniqueId());
+		}
+		Menu menu = service.tracker().currentMenuOf(viewer);
+		if (menu == null) return;
+		// Untrack before close — the resulting InventoryCloseEvent's tracked-check then fails, exempting this
+		// programmatic close from the veto gate above, matching the click listener's own re-entrancy guard.
+		service.tracker().untrack(viewer);
+		try {
+			// LOWEST so we run before Bukkit saves the player's inventory — items returned from the menu land in
+			// the player's saved state, not lost on warning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/registry/InMemoryMenuRegistry.java', LF will be replaced by CRLF the next time Git touches it
the way out.
+			menu.close(viewer, CloseReason.PLAYER_DISCONNECT);
+		} catch (Exception ex) {
+			log.warn("Menu close on disconnect failed for {}: {}", viewer.getName(), ex.toString(), ex);
+		}
+	}
+
+	@Nullable
+	private MenuHolder ownHolder(Inventory inventory) {
+		if (!(inventory.getHolder() instanceof MenuHolder holder)) return null;
+		return holder.service() == service ? holder : null;
+	}
+}
