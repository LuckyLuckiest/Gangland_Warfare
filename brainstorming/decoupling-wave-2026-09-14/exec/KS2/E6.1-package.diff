+	}
+
+	public static ItemComponent of(Material material) {
+		return new ItemComponent(new ItemBuilder(material).build());
+	}
+
+	public static ItemComponent of(ItemStack item) {
+		return new ItemComponent(item.clone());
+	}
+
+	public static ItemComponent of(ItemBuilder builder) {
+		return new ItemComponent(builder.build());
+	}
+
+	public ItemComponent name(String name) {
+		this.item = new ItemBuilder(item).setDisplayName(name).build();
+		return this;
+	}
+
+	public ItemComponent lore(String... lore) {
+		this.item = new ItemBuilder(item).setLore(lore).build();
+		return this;
+	}
+
+	public ItemComponent amount(int amount) {
+		this.item = new ItemBuilder(item).setAmount(amount).build();
+		return this;
+	}
+
+	/** Mark this slot interactive — see {@link SlotView#interactive(boolean)}. Default {@code false}. */
