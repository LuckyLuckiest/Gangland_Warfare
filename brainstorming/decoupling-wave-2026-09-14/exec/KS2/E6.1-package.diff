+package org.luckyraven.keystone.inventory.click;
+
+import org.bukkit.event.inventory.ClickType;
+
+imwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/click/SlotHandlers.java', LF will be replaced by CRLF the next time Git touches it
port java.util.Locale;
+import java.util.Optional;
+
+/**
+ * The set of click gestures a slot can bind a distinct {@link ClickHandler} to.
+ *
+ * <p>{@link #resolutionOrder(ClickType)} encodes the most-specific-first routing: a {@code SHIFT_LEFT} click
+ * prefers a {@link #SHIFT_LEFT} handler, then falls through to {@link #LEFT}, then {@link #ANY}.
+ *
+ * <p>{@link #DOUBLE_CLICK} is the deliberate exception: it resolves <em>only</em> to an explicit
+ * {@link #DOUBLE_CLICK} handler, never falling through to {@link #LEFT} or {@link #ANY}. A physical double-click
+ * sends two click packets — a {@code LEFT} followed by a {@code DOUBLE_CLICK} — so the left/any handler already
+ * fired on the first packet. Falling through would run it a second time.
+ *
+ * <p>Ported unchanged (bar the package) from Oriel's {@code core.click.ClickKind} as part of Keystone Phase E6.
+ */
+public enum ClickKind {
+
+	LEFT("on_left_click", ClickType.LEFT),
+	RIGHT("on_right_click", ClickType.RIGHT),
+	MIDDLE("on_middle_click", ClickType.MIDDLE),
+	SHIFT_LEFT("on_shift_left_click", ClickType.SHIFT_LEFT),
+	SHIFT_RIGHT("on_shift_right_click", ClickType.SHIFT_RIGHT),
+	DROP("on_drop", ClickType.DROP),
+	NUMBER_KEY("on_number_key", ClickType.NUMBER_KEY),
+	DOUBLE_CLICK("on_double_click", ClickType.DOUBLE_CLICK),
+	ANY("on_click", null);
+
+	private final String    yamlKey;
+	private final ClickType bukkitType;
+
+	ClickKind(String yamlKey, ClickType bukkitType) {
+		this.yamlKey    = yamlKey;
+		this.bukkitType = bukkitType;
+	}
+
+	/** The YAML key that binds this click kind — e.g. {@code on_left_click} for {@link #LEFT}. */
+	public String yamlKey() {
+		return yamlKey;
+	}
+
+	/**
+	 * The representative Bukkit {@link ClickType} for this kind, or empty for {@link #ANY} (the catch-all, which
+	 * has no single click type).
+	 */
+	public Optional<ClickType> bukkitType() {
+		return Optional.ofNullable(bukkitType);
+	}
+
+	/**
+	 * Resolves a YAML key (e.g. {@code on_left_click}) back to its {@link ClickKind}, case-insensitively. Empty
+	 * when the key matches no known click kind.
+	 */
+	public static Optional<ClickKind> fromYamlKey(String key) {
+		if (key == null) {
+			return Optional.empty();
+		}
+		String normalized = key.trim().toLowerCase(Locale.ROOT);
+		for (ClickKind kind : values()) {
+			if (kind.yamlKey.equals(normalized)) {
+				return Optional.of(kind);
+			}
+		}
+		return Optional.empty();
+	}
+
+	private static final ClickKind[] ONLY_ANY     = { ANY };
+	private static final ClickKind[] LEFT_CHAIN   = { LEFT, ANY };
+	private static final ClickKind[] RIGHT_CHAIN  = { RIGHT, ANY };
+	private static final ClickKind[] MIDDLE_CHAIN = { MIDDLE, ANY };
+	private static final ClickKind[] SLEFT_CHAIN  = { SHIFT_LEFT, LEFT, ANY };
+	private static final ClickKind[] SRIGHT_CHAIN = { SHIFT_RIGHT, RIGHT, ANY };
+	private static final ClickKind[] DROP_CHAIN   = { DROP, ANY };
+	private static final ClickKind[] NUMBER_CHAIN = { NUMBER_KEY, ANY };
+	private static final ClickKind[] DOUBLE_CHAIN = { DOUBLE_CLICK };
+
+	/**
+	 * The ordered list of kinds to try when routing a {@link ClickType}, most specific first, always ending at
+	 * {@link #ANY}. An unrecognised click resolves only against {@link #ANY}.
+	 */
+	public static ClickKind[] resolutionOrder(ClickType type) {
+		return switch (type) {
+			case LEFT, WINDOW_BORDER_LEFT, CREATIVE -> LEFT_CHAIN;
+			case RIGHT, WINDOW_BORDER_RIGHT         -> RIGHT_CHAIN;
+			case MIDDLE                             -> MIDDLE_CHAIN;
+			case SHIFT_LEFT                         -> SLEFT_CHAIN;
+			case SHIFT_RIGHT                        -> SRIGHT_CHAIN;
+			case DROP, CONTROL_DROP                 -> DROP_CHAIN;
+			case NUMBER_KEY                         -> NUMBER_CHAIN;
+			case DOUBLE_CLICK                       -> DOUBLE_CHAIN;
+			default                                 -> ONLY_ANY;
+		};
+	}
+}
