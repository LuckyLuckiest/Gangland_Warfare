+package org.luckyraven.keystone.inventory.tracking;
+
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.inventory.CloseReason;
+import org.luckyraven.keystone.inventory.Menu;
+
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Tracks which player has which menu open right now, for one {@code InventoryService}. Powers the unified
+ * close-on-shutdown pipeline so menus holding real player items get a chance to return them before Bukkit
+ * blanket-closes inventories.
+ *
+ * <p>Menu types call {@link #track(Player, Menu)} on open and {@link #untrack(Player)} on natural close.
+ * {@code MenuListener} additionally drives:
+ *
+ * <ul>
+ *   <li>{@code Plawarning: in the working copy of 'keystone-inventory/src/test/java/org/luckyraven/keystone/inventory/InventoryServiceLifecycleTest.java', LF will be replaced by CRLF the next time Git touches it
yerQuitEvent} → {@code Menu.close(player, PLAYER_DISCONNECT)} for the disconnecting player</li>
+ *   <li>{@code InventoryService.onPreClear} (reload step) → {@code Menu.close(player, RELOAD)} for everyone</li>
+ *   <li>{@code InventoryService.onShutdown} (plugin disable) → {@code Menu.close(player, PLUGIN_DISABLE)}</li>
+ * </ul>
+ *
+ * <p>Ported from Oriel's {@code core.registry.OpenMenuTracker} as part of Keystone Phase E6. Instance-scoped only
+ * — Oriel's static {@code MenuTracking} accessor is deliberately not ported (the shared-classloader constraint
+ * forbids a static singleton holding per-plugin data; each consumer's {@code InventoryService} owns its own
+ * tracker instance).
+ */
+public interface OpenMenuTracker {
+
+	/** Note that {@code viewer} just opened {@code menu}. Replaces any previous entry for the same player. */
+	void track(Player viewer, Menu menu);
+
+	/** Forget any entry for {@code viewer}. No-op if the player wasn't tracked. */
+	void untrack(Player viewer);
+
+	/** @return the menu currently registered for {@code viewer}, or {@code null} if none. */
+	@Nullable
+	Menu currentMenuOf(Player viewer);
+
+	/** @return the UUIDs of every player with a tracked menu open. Snapshot — safe to iterate. */
+	Set<UUID> currentViewers();
+
+	/**
+	 * Drive {@link Menu#close(Player, CloseReason)} on every tracked player with the supplied reason. Used by the
+	 * lifecycle hooks. Implementations clear the registry before invoking close so re-entrant close listeners
+	 * (e.g. {@code MenuListener} firing as Bukkit auto-closes) see no entry and no-op.
+	 */
+	void closeAll(CloseReason reason);
+}
