+package org.luckyraven.keystone.inventory.registry;
+
+import org.bukkit.entity.Player;
+import org.luckyraven.keystone.inventory.Menu;
+
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Maps registered menu names to factory functions. Each {@link #open(Player, String)} call invokes the factory and
+ * opens a fresh {@link Menu} instance, so menus stay stateless between opens unless the factory captures state.
+ *
+ * <pre>{@code
+ * MenuRegistry registry = ...;
+ * registry.register("shop", () -> ChestMenu.builder()
+ *     .title("&6Shop")
+ *     .rows(6)
+ *     .build());
+ * registry.open(player, "shop");
+ * }</pre>
+ *
+ * <p>Ported from Oriel's {@code core.registry.MenuRegistry} as part of Keystone Phase E6, minus the two
+ * {@code ArgumentProcessorSpec} default methods and {@code registerSource}/{@code source} — argument bindings and
+ * item-provider sources are Oriel's advanced features, not part of the basic mechanism.
+ */
+public interface MenuRegistry {
+
+	/** Register a menu under {@code name}. The factory is invoked per open, producing a fresh menu instance. */
+	void register(String name, Supplier<Menu> factory);
+
+	/** Remove a registered menu. No-op if {@code name} is unknown. */
+	void unregister(String name);
+
+	/** Build and open the menu registered under {@code name} for the given player. Returns {@code false} if unknown. */
+	boolean open(Player player, String name);
+
+	/**
+	 * Re-open the menu the player viewed before the current one. Pops the player's navigation trail and opens the
+	 * previous entry without recording it (so repeated backs walk the trail rather than ping-ponging). Returns
+	 * {@code false} when there is nothing to go back to.
+	 *
+	 * <p>The default is a no-op for registry implementations that don't track navigation; {@link InMemoryMenuRegistry}
+	 * overrides it.
+	 */
+	default boolean openPrevious(Player player) {
+		return false;
+	}
+
+	/** All currently registered menu names. */
+	Set<String> registeredNames();
+
+	/** Whether a menu has been registered under {@code name}. */
+	boolean isRegistered(String name);
+}
