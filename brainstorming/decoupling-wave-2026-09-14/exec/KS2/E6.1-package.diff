@@ -0,0 +1,465 @@
+package org.luckyraven.keystone.inventory.chest;
+
+import lombok.CustomLog;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+import org.bukkit.event.inventory.ClickType;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryCloseEvent;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.ItemStack;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.diagnostics.Guard;
+import org.luckyraven.keystone.inventory.CloseReason;
+import org.luckyraven.keystone.inventory.InventoryService;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.inventory.click.ClickHandler;
+import org.luckyraven.keystone.inventory.click.ClickKind;
+import org.luckyraven.keystone.inventory.click.SlotHandlers;
+import org.luckyraven.keystone.inventory.component.Component;
+import org.luckyraven.keystone.inventory.component.ItemHoldingComponent;
+import org.luckyraven.keystone.inventory.registry.MenuRegistry;
+import org.luckyraven.keystone.inventory.spi.MenuHolder;
+import org.luckyraven.keystone.inventory.spi.MenuTarget;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+import org.luckyraven.keystone.util.ChatUtil;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Predicate;
+import java.util.function.Supplier;
+
+/**
+ * Concrete chest-shaped {@link Menu} — the basic mechanism only. Construction is via
+ * {@link ChestMenu#builder(InventoryService)}; there is no service-less overload (unlike Oriel's {@code builder()}),
+ * because every menu needs a real {@link InventoryService} to track/untrack itself and to identify its
+ * {@link MenuHolder} — there is no static fallback tracker in Keystone (the shared-classloader constraint forbids
+ * one; see {@code CLAUDE.md}).
+ *
+ * <p><b>Ported from Oriel's {@code chest.ChestMenu}</b> (the ~200-line core of its 929-line class) as part of
+ * Keystone Phase E6. Everything advanced — animated titles/items, opening-sequence reveal, view/close requirement
+ * gates, deposit-slot bookkeeping ({@code snapshotDeposits}/{@code consumeDeposits}/{@code returnDeposits}),
+ * paginated-region invalidation, command-argument binding — stays in Oriel's own subclass.
+ *
+ * <p><b>Extension points (review pass 2026-09-17, finding F4 — a 1.11.0 requirement, not deferred).</b> This class
+ * is deliberately {@code non-final} with {@code protected} fields and render hooks so Oriel's rebase can subclass
+ * it instead of re-copying it: {@link #components}, {@link #inventory}, {@link #holder}, {@link #viewer} are
+ * protected fields; {@link #renderAll}, {@link #rerenderSlot}, {@link #applyFillIfEmpty}, {@link #ensureTitleFor},
+ * {@link #resolveTitle} are protected and overridable; {@link #titleSource} is a settable
+ * {@code Supplier<String>} an animated-title subclass can swap for its own frame-cycling implementation; and
+ * {@link MenuHolder#service()} is public.
+ */
+@CustomLog
+public class ChestMenu implements Menu, MenuTarget {
+
+	protected final Map<Integer, Component<?>> components;
+	protected final int                         size;
+	@Nullable
+	protected final MenuRegistry                registry;
+	protected       PlaceholderProvider          placeholders;
+	@Nullable
+	protected final Component<?>                 fillComponent;
+	/**
+	 * Title source. A plain {@code Supplier<String>} for the common case (a constant {@code &}-coded string with
+	 * possible {@code %placeholder%} tokens, resolved per-open) — settable so a subclass can substitute its own
+	 * frame-cycling implementation (F4). Oriel's flicker-free packet-bridge animated-title swap is NOT carried
+	 * over; only the "rebuild the inventory when the resolved static title changes" mechanic is.
+	 */
+	protected       Supplier<String>             titleSource;
+	private final   SlotHandlers                 handlers        = new SlotHandlers();
+	private final   Set<Integer>                 interactiveSlots = new HashSet<>();
+
+	protected final InventoryService service;
+	protected       Inventory        inventory;
+	protected       MenuHolder       holder;
+
+	@Nullable
+	protected String       lastResolvedTitle;
+	@Nullable
+	protected Player       viewer;
+	@Nullable
+	protected String       requiredPermission;
+	@Nullable
+	protected ClickHandler onCloseHandler;
+	@Nullable
+	protected ClickHandler onOpenHandler;
+	@Nullable
+	protected String            name;
+	protected int               clickDelayMillis;
+	/**
+	 * Simple predicate-based close gate — the basic-mechanism counterpart of Oriel's {@code RequirementHook}-based
+	 * {@code closeRequirement} (fail-action chains and {@code RequirementSet} stay in Oriel; this is just
+	 * "should this close be undone?"). {@code null} (the default) never vetoes.
+	 */
+	@Nullable
+	protected Predicate<Player> closeVeto;
+
+	public ChestMenu(Inventory inventory, MenuHolder holder, Map<Integer, Component<?>> components,
+	                 InventoryService service, @Nullable Component<?> fillComponent,
+	                 @Nullable PlaceholderProvider placeholders, @Nullable Supplier<String> titleSource) {
+		this.inventory     = inventory;
+		this.holder        = holder;
+		this.components    = new HashMap<>(components);
+		this.size          = inventory.getSize();
+		this.service       = service;
+		this.registry      = service.registry();
+		this.placeholders  = placeholders != null ? placeholders : PassthroughPlaceholders.INSTANCE;
+		this.fillComponent = fillComponent;
+		this.titleSource   = titleSource != null ? titleSource : () -> "";
+	}
+
+	public static ChestMenuBuilder builder(InventoryService service) {
+		return new ChestMenuBuilder(service);
+	}
+
+	public PlaceholderProvider placeholders() {
+		return placeholders;
+	}
+
+	public void requiredPermission(@Nullable String permission) {
+		this.requiredPermission = permission;
+	}
+
+	public void onCloseHandler(@Nullable ClickHandler handler) {
+		this.onCloseHandler = handler;
+	}
+
+	public void onOpenHandler(@Nullable ClickHandler handler) {
+		this.onOpenHandler = handler;
+	}
+
+	public void name(@Nullable String name) {
+		this.name = name;
+	}
+
+	@Nullable
+	public String name() {
+		return name;
+	}
+
+	public void clickDelayMillis(int millis) {
+		this.clickDelayMillis = millis;
+	}
+
+	public void closeVeto(@Nullable Predicate<Player> veto) {
+		this.closeVeto = veto;
+	}
+
+	/**
+	 * {@inheritDoc} The basic mechanism's veto is a plain predicate ({@link ChestMenuBuilder#vetoClose}) — no
+	 * fail-action chain. {@code MenuListener} re-opens the menu next tick when this returns {@code true} (Bukkit
+	 * close events can't be cancelled). Oriel's subclass overrides this with its
+	 * {@code RequirementHook}-based {@code closeRequirement} instead of setting {@link #closeVeto}.
+	 */
+	@Override
+	public boolean vetoesClose(Player player) {
+		return closeVeto != null && closeVeto.test(player);
+	}
+
+	@Override
+	public int clickDelayMillis() {
+		return clickDelayMillis;
+	}
+
+	@Override
+	public Inventory bukkitInventory() {
+		return inventory;
+	}
+
+	public int size() {
+		return size;
+	}
+
+	public MenuHolder holder() {
+		return holder;
+	}
+
+	@Override
+	public void open(Player player) {
+		if (requiredPermission != null && !requiredPermission.isEmpty() && !player.hasPermission(requiredPermission)) {
+			player.sendMessage(ChatColor.RED + "You don't have permission to open this menu.");
+			return;
+		}
+		this.viewer = player;
+		ensureTitleFor(player);
+		// Track BEFORE the initial render so a PlaceholderProvider that looks up the player's current menu sees
+		// this menu on the first render too, not just after a click.
+		service.tracker().track(player, this);
+		renderAll(player);
+		player.openInventory(inventory);
+		dispatchOnOpen(player);
+	}
+
+	@Override
+	public void close(Player player) {
+		// Untracking BEFORE closeInventory means the close event this triggers fails MenuListener's
+		// currentMenuOf == target check — which is what exempts programmatic closes from the close gate without
+		// any extra state.
+		service.tracker().untrack(player);
+		if (player.getOpenInventory().getTopInventory() == inventory) {
+			player.closeInventory();
+		}
+	}
+
+	/**
+	 * Returns every registered {@link ItemHoldingComponent}'s held items to {@code player}, then closes normally.
+	 * Reached only via {@code InventoryService}'s reload/shutdown sweep ({@link CloseReason#RELOAD} /
+	 * {@link CloseReason#PLUGIN_DISABLE}) and the disconnect handler ({@link CloseReason#PLAYER_DISCONNECT}) — a
+	 * live Bukkit close event (a genuine Escape-press) never reaches this overload; {@code MenuListener.onClose}
+	 * calls {@link #onClose} directly instead. Held-item return on a genuine user close is therefore out of scope
+	 * for this basic mechanism; a consumer whose components hold real items across a plain Escape-press (Oriel's
+	 * deposit slots) adds that in its own subclass.
+	 */
+	@Override
+	public void close(Player player, CloseReason reason) {
+		returnHeldItems(player, reason);
+		close(player);
+	}
+
+	private void returnHeldItems(Player player, CloseReason reason) {
+		for (Map.Entry<Integer, Component<?>> entry : components.entrySet()) {
+			if (entry.getValue() instanceof ItemHoldingComponent held) {
+				returnHeldItemsForSlot(player, held, reason);
+			}
+		}
+	}
+
+	/**
+	 * Drains one {@link ItemHoldingComponent}'s held state for {@code player} into their inventory (leftovers drop
+	 * at their feet), then clears it. Shared by {@link #returnHeldItems} (every slot, close-time) and
+	 * {@link #adoptComponentsFrom} (just the one slot a rerender is about to drop). No-op if the component is
+	 * holding nothing for {@code player}.
+	 */
+	protected void returnHeldItemsForSlot(Player player, ItemHoldingComponent held, CloseReason reason) {
+		List<ItemStack> items = held.heldItems(player);
+		if (items.isEmpty()) return;
+
+		int returned = 0;
+		int dropped  = 0;
+		for (ItemStack stack : items) {
+			if (stack == null || stack.getType() == Material.AIR || stack.getAmount() <= 0) continue;
+			int                     requested = stack.getAmount();
+			Map<Integer, ItemStack> leftovers = player.getInventory().addItem(stack);
+			if (leftovers.isEmpty()) {
+				returned += requested;
+				continue;
+			}
+			int leftoverCount = 0;
+			for (ItemStack leftover : leftovers.values()) {
+				player.getWorld().dropItemNaturally(player.getLocation(), leftover);
+				leftoverCount += leftover.getAmount();
+			}
+			returned += requested - leftoverCount;
+			dropped += leftoverCount;
+		}
+		held.clearHeld(player);
+
+		if (returned > 0 || dropped > 0) {
+			log.debug("Returned {} held item(s) to {} from chest menu (reason={}); {} dropped at feet (inv full)",
+			          returned, player.getName(), reason, dropped);
+		}
+	}
+
+	/**
+	 * Override of the {@link MenuTarget} hook called by {@code MenuListener}. Dispatches the registered
+	 * {@code on_close} handler (set via {@link ChestMenuBuilder#onClose}) with a synthetic {@link ChestClickContext}.
+	 */
+	@Override
+	public void onClose(InventoryCloseEvent event, Player player) {
+		if (onCloseHandler == null) return;
+		ChestClickContext ctx = lifecycleContext(player);
+		Guard.of("lifecycle.close")
+		     .with("menu", String.valueOf(name()))
+		     .with("player", player.getName())
+		     .run(() -> onCloseHandler.onClick(ctx));
+	}
+
+	private void dispatchOnOpen(Player player) {
+		if (onOpenHandler == null) return;
+		ChestClickContext ctx = lifecycleContext(player);
+		Guard.of("lifecycle.open")
+		     .with("menu", String.valueOf(name()))
+		     .with("player", player.getName())
+		     .run(() -> onOpenHandler.onClick(ctx));
+	}
+
+	private ChestClickContext lifecycleContext(Player player) {
+		return new ChestClickContext(player, this, -1, ClickType.LEFT, new ItemStack(Material.AIR), null, registry);
+	}
+
+	@Override
+	public void rerender() {
+		if (viewer == null) return;
+		renderAll(viewer);
+	}
+
+	/**
+	 * Re-render this ALREADY-OPEN menu using {@code fresh}'s computed component set — no new Bukkit inventory, no
+	 * close/open round trip, no flicker. Used by {@code MenuFlow.rerender()} (E6.2): {@code fresh} is a throwaway
+	 * {@link ChestMenu} built the normal way purely to compute its layered component set; its own
+	 * {@link #bukkitInventory()} is discarded unopened. Slots that existed on this menu but not on {@code fresh}
+	 * are cleared first — and if the outgoing component there is an {@link ItemHoldingComponent} holding items for
+	 * the viewer, those items are returned first via {@link #returnHeldItemsForSlot} (reason
+	 * {@link CloseReason#NAVIGATION}), so they never become unreturnable once the component itself is gone.
+	 */
+	public void adoptComponentsFrom(ChestMenu fresh) {
+		if (viewer == null) return;
+		for (Integer oldSlot : new HashSet<>(components.keySet())) {
+			if (!fresh.components.containsKey(oldSlot)) {
+				Component<?> outgoing = components.get(oldSlot);
+				if (outgoing instanceof ItemHoldingComponent held) {
+					returnHeldItemsForSlot(viewer, held, CloseReason.NAVIGATION);
+				}
+				inventory.setItem(oldSlot, null);
+				clearHandlers(oldSlot);
+			}
+		}
+		components.clear();
+		components.putAll(fresh.components);
+		rerender();
+	}
+
+	protected void rerenderSlot(int slot) {
+		if (viewer == null) return;
+		Component<?> component = components.get(slot);
+		if (component == null) {
+			inventory.setItem(slot, null);
+			clearHandlers(slot);
+			applyFillIfEmpty(slot, viewer);
+			return;
+		}
+		renderOne(slot, component, viewer);
+		applyFillIfEmpty(slot, viewer);
+	}
+
+	@Override
+	public void setHandler(int slot, ClickKind kind, ClickHandler handler) {
+		handlers.set(slot, kind, handler);
+	}
+
+	@Override
+	public void clearHandlers(int slot) {
+		handlers.clear(slot);
+	}
+
+	@Override
+	public boolean isInteractive(int slot) {
+		return interactiveSlots.contains(slot);
+	}
+
+	@Override
+	public void setInteractive(int slot, boolean interactive) {
+		if (interactive) {
+			interactiveSlots.add(slot);
+		} else {
+			interactiveSlots.remove(slot);
+		}
+	}
+
+	/**
+	 * Called by {@code MenuListener} after it has applied the cancel/interactive policy. Looks up the handler for
+	 * the clicked slot + click type and invokes it. No-op if no handler is registered.
+	 */
+	@Override
+	public void dispatchClick(InventoryClickEvent event, Player player) {
+		int slot = event.getRawSlot();
+		if (slot < 0 || slot >= size) return;
+
+		ClickType    type    = event.getClick();
+		ClickHandler handler = handlers.resolve(slot, type);
+		if (handler == null) return;
+
+		ItemStack clicked = event.getCurrentItem();
+		ChestClickContext ctx = new ChestClickContext(player, this, slot, type,
+		                                              clicked == null ? new ItemStack(Material.AIR) : clicked, event,
+		                                              registry);
+		Guard.of("click.dispatch")
+		     .with("menu", String.valueOf(name()))
+		     .with("slot", String.valueOf(slot))
+		     .with("player", player.getName())
+		     .run(() -> handler.onClick(ctx));
+	}
+
+	/**
+	 * Resolve {@link #titleSource}'s value against {@code player} (placeholders + colour codes) and, if the result
+	 * differs from the previously-resolved title, recreate the backing Bukkit inventory + holder so the new title
+	 * takes effect — Bukkit titles are immutable post-creation. The new inventory inherits the same size and the
+	 * same logical menu via a fresh {@link MenuHolder}; {@code MenuListener} looks up the menu via
+	 * {@link MenuHolder#target()}, so it continues to work.
+	 *
+	 * <p>No-op when the resolved title is empty.
+	 */
+	protected void ensureTitleFor(Player player) {
+		String raw = titleSource.get();
+		if (raw == null || raw.isEmpty()) return;
+
+		String resolved = ChatUtil.color(resolveTitle(player, raw));
+		if (resolved.equals(lastResolvedTitle)) return;
+
+		MenuHolder fresh = new MenuHolder(service);
+		fresh.setTarget(this);
+		Inventory next = Bukkit.createInventory(fresh, size, resolved);
+
+		this.holder            = fresh;
+		this.inventory         = next;
+		this.lastResolvedTitle = resolved;
+	}
+
+	/**
+	 * Resolve {@code %placeholder%} tokens in the title for {@code player}, logging and falling back to the raw
+	 * string if the provider throws.
+	 */
+	protected String resolveTitle(Player player, String raw) {
+		try {
+			return placeholders.resolve(player, raw);
+		} catch (Exception ex) {
+			log.warn("Title placeholder resolve failed for \"{}\" (player={}): {}", raw, player.getName(),
+			     warning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/chest/ChestMenuBuilder.java', LF will be replaced by CRLF the next time Git touches it
    ex.toString());
+			return raw;
+		}
+	}
+
+	protected void renderAll(Player player) {
+		// In-place render: each component's renderInto writes to the slot via SlotView.setItem, overwriting the
+		// previous frame slot-by-slot — skips a bulk inventory clear up-front, avoiding the single-tick blank
+		// window that causes visible flicker on rapid clicks of a control.
+		for (Map.Entry<Integer, Component<?>> entry : components.entrySet()) {
+			ChestSlotView view = renderOne(entry.getKey(), entry.getValue(), player);
+			if (!view.wasTouched()) {
+				inventory.setItem(entry.getKey(), null);
+				clearHandlers(entry.getKey());
+			}
+		}
+		// Apply fill at render time — covers slots without any component AND slots whose component rendered
+		// nothing (the wasTouched() == false branch above already cleared them, so they're null now).
+		if (fillComponent != null) {
+			for (int slot = 0; slot < size; slot++) {
+				if (inventory.getItem(slot) == null) {
+					renderOne(slot, fillComponent, player);
+				}
+			}
+		}
+	}
+
+	private ChestSlotView renderOne(int slot, Component<?> component, Player player) {
+		ChestRenderContext ctx  = new ChestRenderContext(player, this, placeholders);
+		ChestSlotView      view = new ChestSlotView(this, slot);
+		// Guard the render so one misbehaving component renders blank instead of aborting the whole menu render.
+		Guard.of("render.component")
+		     .with("menu", String.valueOf(name()))
+		     .with("slot", String.valueOf(slot))
+		     .run(() -> component.renderInto(view, ctx));
+		return view;
+	}
+
+	protected void applyFillIfEmpty(int slot, Player player) {
+		if (fillComponent == null) return;
+		if (inventory.getItem(slot) != null) return;
+		renderOne(slot, fillComponent, player);
+	}
+}
