+package org.luckyraven.keystone.inventory.chest;
+
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.Inventory;
+import org.jetbrains.annotations.Nullable;
+import org.luckyraven.keystone.inventory.InventoryService;
+import org.luckyraven.keystone.inventory.MenuBuilder;
+import org.luckyraven.keystone.inventory.click.ClickHandler;
+import org.luckyraven.keystone.inventory.component.BorderComponent;
+import org.luckyraven.keystone.inventory.component.Component;
+import org.luckyraven.keystone.inventory.component.FillComponent;
+import org.luckyraven.keystone.inventory.component.LineComponent;
+import org.luckyraven.keystone.inventory.spi.MenuHolder;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+import org.luckyraven.keystone.util.ChatUtil;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Predicate;
+import java.util.function.Supplier;
+
+/**
+ * Fluent builder for {@link ChestMenu}. Validation runs on {@link #build()} (rows in [1,6], slot indices in
+ * range), never on first open.
+ *
+ * <p>Composition order at build time: border fills the outer ring, lines fill their row/column, then explicit
+ * {@code .slot(int, Component)} calls OVERRIDE anything below (no {@code CompositeComponent} — an explicit slot
+ * simply replaces whatever decoration put there, per the E6 plan). Fill applies to remaining empty slots at
+ * render time, not here.
+ *
+ * <pre>{@code
+ * ChestMenu shop = ChestMenu.builder(inventoryService)
+ *     .title("&6Shop")
+ *     .rows(6)
+ *     .border(Material.BLACK_STAINED_GLASS_PANE)
+ *     .slot(13, ItemComponent.of(Material.DIAMOND)
+ *         .name("&bBuy Diamond")
+ *         .lore("&7Click to buy", "&7Costs &e$500")
+ *         .onLeftClick(ctx -> ctx.player().performCommand("buy diamond")))
+ *     .build();
+ * }</pre>
+ *
+ * <p>Ported from Oriel's {@code chest.ChestMenuBuilder} as part of Keystone Phase E6, trimmed to rows/title/
+ * permission/fill/border/line/slot/interactive/clickDelay/onOpen/onClose/vetoClose (Oriel's {@code RequirementHook}-based
+ * view/close requirements, opening sequences, save-history, refresh-interval and paginated regions are its
+ * advanced features — regions land in E6.2 as {@code PagedRegion}, the rest stay in Oriel). {@link #interactive(int)}
+ * is new — Gangland's per-slot "draggable" flag, folded in. {@link #vetoClose(Predicate)} is the basic-mechanism
+ * stand-in for Oriel's {@code closeRequirement}: a plain predicate, no fail-action chain.
+ */
+public final class ChestMenuBuilder implements MenuBuilder<ChestMenu, ChestMenuBuilder> {
+
+	private final InventoryService           service;
+	private final Map<Integer, Component<?>> explicitSlots    = new HashMap<>();
+	private final List<LineComponent>        lines            = new ArrayList<>();
+	private final Set<Integer>               interactiveSlots = new HashSet<>();
+	private       Supplier<String>           titleSource      = () -> "";
+	private       int                        rows             = 1;
+	@Nullable
+	private       BorderComponent            border;
+	@Nullable
+	private       FillComponent              fill;
+	@Nullable
+	private       PlaceholderProvider        placeholders;
+	@Nullable
+	private       String                     requiredPermission;
+	@Nullable
+	private       ClickHandler               onCloseHandler;
+	@Nullable
+	private       ClickHandler               onOpenHandler;
+	@Nullable
+	private       String                     name;
+	private       int                        clickDelayMillis;
+	@Nullable
+	private       Predicate<Player>          closeVeto;
+
+	ChestMenuBuilder(InventoryService service) {
+		this.service = service;
+	}
+
+	public ChestMenuBuilder title(String title) {
+		this.titleSource = () -> title;
+		return this;
+	}
+
+	/** Settable title source (F4) — a consumer with its own animated-title mechanism supplies one here. */
+	public ChestMenuBuilder title(Supplier<String> titleSource) {
+		this.titleSource = titleSource == null ? () -> "" : titleSource;
+		return this;
+	}
+
+	public ChestMenuBuilder rows(int rows) {
+		this.rows = rows;
+		return this;
+	}
+
+	/** Place one component at a slot. Overrides any decoration (border/line) already covering it. */
+	public ChestMenuBuilder slot(int slot, Component<?> component) {
+		explicitSlots.put(slot, component);
+		return this;
+	}
+
+	public ChestMenuBuilder border(Material material) {
+		this.border = BorderComponent.of(material);
+		return this;
+	}
+
+	public ChestMenuBuilder border(BorderComponent borderComponent) {
+		this.border = borderComponent;
+		return this;
+	}
+
+	public ChestMenuBuilder fill(Material material) {
+		this.fill = FillComponent.of(material);
+		return this;
+	}
+
+	public ChestMenuBuilder fill(FillComponent fillComponent) {
+		this.fill = fillComponent;
+		return this;
+	}
+
+	public ChestMenuBuilder line(LineComponent line) {
+		lines.add(line);
+		return this;
+	}
+
+	/**
+	 * Mark {@code slot} interactive before the first render — Gangland's "draggable" flag. A component's own
+	 * {@code SlotView.interactive(true)} call during render works too and takes effect on every subsequent
+	 * render; this is the builder-time shorthand for a slot with no component of its own.
+	 */
+	public ChestMenuBuilder interactive(int slot) {
+		interactiveSlots.add(slot);
+		return this;
+	}
+
+	/**
+	 * Attach a {@link PlaceholderProvider} so item names/lore resolve their {@code %placeholder%} tokens at render
+	 * time. Default is {@link PassthroughPlaceholders} (returns the raw string unchanged).
+	 */
+	public ChestMenuBuilder placeholders(PlaceholderProvider placeholders) {
+		this.placeholders = placeholders;
+		return this;
+	}
+
+	/**
+	 * Gate menu opening on a Bukkit permission. When set, {@link ChestMenu#open(org.bukkit.entity.Player)} no-opwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/chest/ChestRenderContext.java', LF will be replaced by CRLF the next time Git touches it
s
+	 * for players without the permission and sends them a default "you don't have permission" message.
+	 */
+	public ChestMenuBuilder permission(String permission) {
+		this.requiredPermission = permission;
+		return this;
+	}
+
+	/** Register a handler invoked when the player closes this menu. */
+	public ChestMenuBuilder onClose(ClickHandler handler) {
+		this.onCloseHandler = handler;
+		return this;
+	}
+
+	/** Register a handler invoked when the player opens this menu. Fires once per {@code open()} call. */
+	public ChestMenuBuilder onOpen(ClickHandler handler) {
+		this.onOpenHandler = handler;
+		return this;
+	}
+
+	/** Tag the menu with a name. Surfaces via {@link ChestMenu#name()}. */
+	public ChestMenuBuilder name(String name) {
+		this.name = name;
+		return this;
+	}
+
+	/** Anti-spam debounce: silently ignore repeat clicks within {@code millis} of the previous one. {@code 0} disables it. */
+	public ChestMenuBuilder clickDelay(int millis) {
+		this.clickDelayMillis = millis;
+		return this;
+	}
+
+	/**
+	 * Gate a player-initiated close on a plain predicate: when {@code veto} returns {@code true},
+	 * {@code MenuListener} undoes the close (re-opens the menu next tick — Bukkit close events can't be
+	 * cancelled). The basic-mechanism counterpart of Oriel's {@code RequirementHook}-based
+	 * {@code closeRequirement} — no fail-action chain, just "should this close be undone?".
+	 */
+	public ChestMenuBuilder vetoClose(Predicate<Player> veto) {
+		this.closeVeto = veto;
+		return this;
+	}
+
+	@Override
+	public ChestMenu build() {
+		if (rows < 1 || rows > 6) {
+			throw new IllegalStateException("rows must be in [1, 6], got " + rows);
+		}
+		int size = rows * 9;
+		for (Integer slotIndex : explicitSlots.keySet()) {
+			if (slotIndex < 0 || slotIndex >= size) {
+				throw new IllegalStateException("slot " + slotIndex + " out of range [0, " + size + ")");
+			}
+		}
+		for (Integer slotIndex : interactiveSlots) {
+			if (slotIndex < 0 || slotIndex >= size) {
+				throw new IllegalStateException("interactive slot " + slotIndex + " out of range [0, " + size + ")");
+			}
+		}
+
+		Map<Integer, Component<?>> finalSlots = new HashMap<>();
+		if (border != null) applyBorder(finalSlots, size);
+		for (LineComponent line : lines) applyLine(finalSlots, line, size);
+		// Explicit slots OVERRIDE decoration — no CompositeComponent, per the E6 plan.
+		finalSlots.putAll(explicitSlots);
+
+		MenuHolder holder       = new MenuHolder(service);
+		String     coloredTitle = ChatUtil.color(titleSource.get());
+		Inventory  inventory    = Bukkit.createInventory(holder, size, coloredTitle);
+		ChestMenu  menu = new ChestMenu(inventory, holder, finalSlots, service, fill, placeholders, titleSource);
+		menu.requiredPermission(requiredPermission);
+		menu.onCloseHandler(onCloseHandler);
+		menu.onOpenHandler(onOpenHandler);
+		menu.name(name);
+		menu.clickDelayMillis(clickDelayMillis);
+		menu.closeVeto(closeVeto);
+		for (Integer slot : interactiveSlots) {
+			menu.setInteractive(slot, true);
+		}
+		holder.setTarget(menu);
+		return menu;
+	}
+
+	private void applyBorder(Map<Integer, Component<?>> finalSlots, int size) {
+		int lastRow = (size / 9) - 1;
+		for (int col = 0; col < 9; col++) {
+			finalSlots.put(col, border);
+			finalSlots.put(lastRow * 9 + col, border);
+		}
+		for (int row = 1; row < lastRow; row++) {
+			finalSlots.put(row * 9, border);
+			finalSlots.put(row * 9 + 8, border);
+		}
+	}
+
+	private void applyLine(Map<Integer, Component<?>> finalSlots, LineComponent line, int size) {
+		int totalRows = size / 9;
+		if (line.direction() == LineComponent.Direction.HORIZONTAL) {
+			int row = line.index();
+			if (row < 0 || row >= totalRows) return;
+			for (int col = 0; col < 9; col++) finalSlots.put(row * 9 + col, line);
+		} else {
+			int col = line.index();
+			if (col < 0 || col >= 9) return;
+			for (int row = 0; row < totalRows; row++) finalSlots.put(row * 9 + col, line);
+		}
+	}
+}
