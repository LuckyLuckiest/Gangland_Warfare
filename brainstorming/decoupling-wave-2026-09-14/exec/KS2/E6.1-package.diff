+package org.luckyraven.keystone.inventory.click;
+
+import org.bukkit.entity.Player;
+import org.bukkit.event.inventory.ClickType;
+import org.bukkit.inventory.ItemStack;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+
+/**
+ * Self-documenting access to everything a click handler typically needs. An instance is passed to every handler
+ * registered through a {@link org.luckyraven.keystone.inventory.component.Component} or builder shorthand
+ * ({@code .onLeftClick(ctx -> ...)}, {@code .onRightClick(ctx -> ...)}, ...).
+ *
+ * <p>Implementations are immutable per click and carry the viewing player, the clicked menu, the raw slot index,
+ * the click type, and the item under the cursor. Reactive helpers ({@link #rerender()}, {@link #rerenderSlot(int)})
+ * are the canonical way to refresh visible state after a click mutates something.
+ *
+ * <p>Ported from Oriel's {@code corwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/click/ClickHandler.java', LF will be replaced by CRLF the next time Git touches it
warning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/click/ClickKind.java', LF will be replaced by CRLF the next time Git touches it
e.click.ClickContext} as part of Keystone Phase E6. {@code openMenu}/{@code openPrevious}
+ * stay on the contract (a {@code MenuRegistry}-backed implementation routes them); {@code HeadlessClickContext}
+ * (Oriel's no-window variant for command-argument fail actions) stays in Oriel — it serves Oriel's YAML action
+ * dialect, not the basic mechanism.
+ */
+public interface ClickContext {
+
+	/** The player who performed the click. */
+	Player player();
+
+	/** The menu the click happened in. */
+	Menu menu();
+
+	/** The raw slot index of the clicked slot, in the menu's coordinate space. */
+	int slot();
+
+	/** Bukkit's classification of the click (LEFT, RIGHT, SHIFT_LEFT, SHIFT_RIGHT, MIDDLE, DROP, ...). */
+	ClickType clickType();
+
+	/** The item that was visible in the clicked slot at the moment of the click. */
+	ItemStack clickedItem();
+
+	/** {@code true} if the click was a shift-click (either shift-left or shift-right). */
+	boolean isShiftClick();
+
+	/** Open another registered menu for the same player. Delegates through the configured {@code MenuOpener}. */
+	void openMenu(String registeredName);
+
+	/**
+	 * Open another registered menu for the same player, passing trailing arguments. The default ignores the args
+	 * and delegates to {@link #openMenu(String)} for contexts that don't route through a registry.
+	 */
+	default void openMenu(String registeredName, String... args) {
+		openMenu(registeredName);
+	}
+
+	/**
+	 * Re-open the menu the player viewed before this one. Walks the player's navigation trail (see
+	 * {@link org.luckyraven.keystone.inventory.tracking.NavigationHistory}); a no-op when there is no previous menu
+	 * to return to. The default is a no-op for click contexts not backed by a registry.
+	 */
+	default void openPrevious() {
+	}
+
+	/** Close the current menu for the player. */
+	void closeMenu();
+
+	/** Suppress default Bukkit handling. Default behaviour is already to cancel; call this to force re-cancel. */
+	void cancel();
+
+	/** Re-run every component on the current menu. */
+	void rerender();
+
+	/** Re-run just the named slot's component. */
+	void rerenderSlot(int slot);
+
+	/**
+	 * The same {@link PlaceholderProvider} the menu used for its render pass. Click handlers resolve
+	 * {@code %placeholder%} tokens via {@code ctx.placeholders().resolve(ctx.player(), raw)} so a consumer's
+	 * message/command actions end up with the same values an item name/lore would show.
+	 */
+	PlaceholderProvider placeholders();
+}
