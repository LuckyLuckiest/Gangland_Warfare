+package org.luckyraven.keystone.inventory.tracking;
+
+import org.bukkit.entity.Player;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Per-player back-stack of registered menu names, powering {@code MenuOpener}/{@code ClickContext.openPrevious()}
+ * "back" nwarning: in the working copy of 'keystone-inventory/src/main/java/org/luckyraven/keystone/inventory/tracking/OpenMenuTracker.java', LF will be replaced by CRLF the next time Git touches it
avigation. The {@code MenuRegistry} records every named open here; a back action pops to the previously
+ * viewed menu.
+ *
+ * <p>Modelled as one bounded {@link Deque} per player whose <b>last element is the menu currently being viewed</b>
+ * and everything before it is the trail to walk back through. {@link #recordOpen(UUID, String)} pushes a new top;
+ * {@link #back(UUID)} drops the current top and returns the one beneath it (the menu to re-open) without pushing —
+ * so backing out of {@code C} after {@code A → B → C} yields {@code B}, then {@code A}, then nothing.
+ *
+ * <p>The deque is bounded (oldest entries drop past {@link #MAX_DEPTH}) so a long navigation chain can't grow
+ * without limit, and {@link #clear(UUID)} wipes a player's trail on disconnect / reload. Keyed by UUID and backed
+ * by a {@link ConcurrentHashMap} so the disconnect listener and the main-thread open path don't race.
+ *
+ * <p>Ported unchanged (bar the package) from Oriel's {@code core.registry.NavigationHistory} as part of Keystone
+ * Phase E6.
+ */
+public final class NavigationHistory {
+
+	/** Maximum trail length kept per player. Older entries fall off the bottom. */
+	public static final int MAX_DEPTH = 32;
+
+	private final Map<UUID, Deque<String>> trails = new ConcurrentHashMap<>();
+
+	/**
+	 * Record that {@code player} just opened the menu named {@code menuName}. A repeat open of the same menu (the
+	 * current top) is ignored so re-renders and self-reopens don't stack duplicates.
+	 */
+	public void recordOpen(UUID player, String menuName) {
+		Deque<String> trail = trails.computeIfAbsent(player, key -> new ArrayDeque<>());
+		if (menuName.equals(trail.peekLast())) {
+			return;
+		}
+		trail.addLast(menuName);
+		while (trail.size() > MAX_DEPTH) {
+			trail.removeFirst();
+		}
+	}
+
+	/**
+	 * Pop the current menu and return the previous one to re-open — the new current. Empty when the player has no
+	 * earlier menu to return to. Does <b>not</b> record the returned menu (it is already the new top), so the
+	 * caller must open it through a path that skips {@link #recordOpen}.
+	 */
+	public Optional<String> back(UUID player) {
+		Deque<String> trail = trails.get(player);
+		if (trail == null || trail.size() <= 1) {
+			return Optional.empty();
+		}
+		trail.removeLast();
+		return Optional.ofNullable(trail.peekLast());
+	}
+
+	/** The menu {@code player} is currently recorded as viewing, or empty when the trail is empty. */
+	public Optional<String> current(UUID player) {
+		Deque<String> trail = trails.get(player);
+		return trail == null ? Optional.empty() : Optional.ofNullable(trail.peekLast());
+	}
+
+	/** Forget {@code player}'s entire trail. Called on disconnect / reload — a fresh session starts with no history. */
+	public void clear(UUID player) {
+		trails.remove(player);
+	}
+
+	/** Convenience overload of {@link #clear(UUID)}. */
+	public void clear(Player player) {
+		clear(player.getUniqueId());
+	}
+}
