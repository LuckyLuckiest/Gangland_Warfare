+package org.luckyraven.keystone.inventory.chest;
+
+import org.bukkit.OfflinePlayer;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+
+/**
+ * No-op {@link PlaceholderProvider}. Returns the raw string unchanged. Used as {@link ChestMenu}'s default until a
+ * consumer wires a real one through {@link ChestMenuBuilder#placeholders(PlaceholderProvider)}.
+ *
+ * <p>Ported unchanged from Oriel's {@code chest.internal.PassthroughPlaceholders} as part of Keystone Phase E6,
+ * package-private (co-located with {@link ChestMenu}/{@link ChestClickContext}, its only callers — Java
+ * package-private access does not reach a {@code .internal} sub-package, so the "package-private" instruction in
+ * the E6 plan's E6.1 table means these support classes live beside {@code ChestMenu} itself, not in a separate
+ * {@code chest.internal} package the way Oriel split them).
+ */
+final class PassthroughPlaceholders implements PlaceholderProvider {
+
+	static final PassthroughPlaceholders INSTANCE = new PassthroughPlaceholders();
+
+	private PassthroughPlaceholders() {
+	}
+
+	@Override
+	public String resolve(OfflinePlayer player, String raw) {
+		return raw;
+	}
+}
