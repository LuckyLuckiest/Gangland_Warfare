+package org.luckyraven.keystone.inventory.tracking;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+import org.luckyraven.keystone.inventory.CloseReason;
+import org.luckyraven.keystone.inventory.Menu;
+import org.luckyraven.keystone.testkit.BukkitStatics;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * {@link DefaultOpenMenuTracker} — track/untrack bookkeeping and the {@link #closeAll} reload/shutdown sweep. Ported
+ * in spirit from Oriel's {@code core.registry.DefaultOpenMenuTracker}; the quit-handling this class used to own as
+ * a {@code Listener} moved to {@code MenuListener} (see {@code MenuListenerTest}) as part of Keystone Phase E6, so
+ * this test covers only the tracking map and {@code closeAll} itself.
+ */
+final class DefaultOpenMenuTrackerTest {
+
+	@Test
+	void trackThenUntrackClearsCurrentMenu() {
+		DefaultOpenMenuTracker tracker = new DefaultOpenMenuTracker();
+		Player                 viewer  = mock(Player.class);
+		when(viewer.getUniqueId()).thenReturn(UUID.randomUUID());
+		Menu menu = mock(Menu.class);
+
+		tracker.track(viewer, menu);
+		assertSame(menu, tracker.currentMenuOf(viewer));
+		assertTrue(tracker.currentViewers().contains(viewer.getUniqueId()));
+
+		tracker.untrack(viewer);
+		assertNull(tracker.currentMenuOf(viewer));
+	}
+
+	@Test
+	void untrackDoesNotTouchNavigationHistory() {
+		// "Navigation does not untrack" — closing a panel mid-MenuFlow (a plain untrack(), not a closeAll sweep)
+		// must not wipe the player's back-trail; only a reload/shutdown sweep does that.
+		NavigationHistory      history = new NavigationHistory();
+		DefaultOpenMenuTracker tracker = new DefaultOpenMenuTracker(history);
+		UUID                   uuid    = UUID.randomUUID();
+		Player                 viewer  = mock(Player.class);
+		when(viewer.getUniqueId()).thenReturn(uuid);
+
+		history.recordOpen(uuid, "shop");
+		tracker.track(viewer, mock(Menu.class));
+		tracker.untrack(viewer);
+
+		assertEquals("shop", history.current(uuid).orElseThrow());
+	}
+
+	@Test
+	void closeAllClosesEveryTrackedMenuWithTheReasonAndClearsNavigationHistory() {
+		NavigationHistory      history = new NavigationHistory();
+		DefaultOpenMenuTracker tracker = new DefaultOpenMenuTracker(history);
+		UUID                   uuid    = UUID.randomUUID();
+		Player                 viewer  = mock(Player.class);
+		when(viewer.getUniqueId()).thenReturn(uuid);
+		Menu menu = mock(Menu.class);
+		history.recordOpen(uuid, "shop");
+		tracker.track(viewer, menu);
+
+		try (BukkitStatics bukkit = BukkitStatics.install()) {
+			bukkit.statics().when(() -> Bukkit.getPlayer(eq(uuid))).thenReturn(viewer);
+
+			tracker.closeAll(CloseReason.RELOAD);
+
+			verify(menu).close(viewer, CloseReason.RELOAD);
+		}
+		assertNull(tracker.currentMenuOf(viewer));
+		assertTrue(history.current(uuid).isEmpty());
+	}
+
+	@Test
+	void closeAllSkipsOfflinePlayersWithoutThrowing() {
+		DefaultOpenMenuTracker tracker = new DefaultOpenMenuTracker();
+		UUID                   uuid    = UUID.randomUUID();
+		Player                 viewer  = mock(Player.class);
+		when(viewer.getUniqueId()).thenReturn(uuid);
+		Menu menu = mock(Menu.class);
+		tracker.track(viewer, menu);
+
+		try (BukkitStatics bukkit = BukkitStatics.install()) {
+			bukkit.statics().when(() -> Bukkit.getPlayer(eq(uuid))).thenReturn(null);
+
+			tracker.closeAll(CloseReason.PLUGIN_DISABLE);
+
+			verify(menu, never()).close(org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+		}
+	}
+
+	@Test
+	void closeAllClearsTheTrackerEvenWithNoNavigationHistory() {
+		DefaultOpenMenuTracker tracker = new DefaultOpenMenuTracker();
+		Player                 viewer  = mock(Player.class);
+		when(viewer.getUniqueId()).thenReturn(UUID.randomUUID());
+		tracker.track(viewer, mock(Menu.class));
+
+		try (BukkitStatics bukkit = BukkitStatics.install()) {
+			bukkit.statics().when(() -> Bukkit.getPlayer(org.mockito.ArgumentMatchers.any(UUID.class)))
+			      .thenReturn(viewer);
+			tracker.closeAll(CloseReason.RELOAD);
+		}
+		assertTrue(tracker.currentViewers().isEmpty());
+	}
+}
