+package org.luckyraven.keystone.inventory;
+
+import org.bukkit.Bukkit;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.luckyraven.keystone.bean.BeanLifecycle;
+import org.luckyraven.keystone.cooldown.CooldownService;
+import org.luckyraven.keystone.inventory.listener.MenuListener;
+import org.luckyraven.keystone.inventory.registry.InMemoryMenuRegistry;
+import org.luckyraven.keystone.inventory.registry.MenuRegistry;
+import org.luckyraven.keystone.inventory.tracking.DefaultOpenMenuTracker;
+import org.luckyraven.keystone.inventory.tracking.NavigationHistory;
+import org.luckyraven.keystone.inventory.tracking.OpenMenuTracker;
+
+/**
+ * Per-consumer root of the inventory mechanism. Each consumer plugin constructs its own instance (no static
+ * registry, no shared-classloader state, per {@code CLAUDE.md}'s shared-classloader constraint) — owns its own
+ * {@link OpenMenuTracker} and {@link MenuRegistry}, sharing one {@link NavigationHistory} between them.
+ *
+ * <p>New in Keystone Phase E6, following the {@code HologramService.registerProtection} precedent from Phase H10:
+ * Keystone ships the {@code MenuListener} class but never registers it itself — {@link #registerListeners(JavaPlugin)}
+ * is the one call a consumer makes at bootstrap, the lazier option over threading a Keystone-jar classloader
+ * reference through the consumer's own {@code @ListenerHandler} scan for one listener.
+ */
+public class InventoryService implements BeanLifecycle {
+
+	private final CooldownService cooldowns;
+	private final OpenMenuTracker tracker;
+	private final MenuRegistry    registry;
+
+	public InventoryService(CooldownService cooldowns) {
+		this.cooldowns = cooldowns;
+		NavigationHistory history = new NavigationHistory();
+		this.tracker  = new DefaultOpenMenuTracker(history);
+		this.registry = new InMemoryMenuRegistry(history);
+	}
+
+	/** This service's {@link OpenMenuTracker} — who has what menu open right now. */
+	public OpenMenuTracker tracker() {
+		return tracker;
+	}
+
+	/** This service's {@link MenuRegistry} — named menu factories and "back" navigation. */
+	public MenuRegistry registry() {
+		return registry;
+	}
+
+	/** The {@link CooldownService} this service's {@code MenuListener} debounces clicks through. */
+	public CooldownService cooldowns() {
+		return cooldowns;
+	}
+
+	/**
+	 * Register this service's {@link MenuListener} (click/drag/close/quit, all four events, one class) under
+	 * {@code owner}. Call once at bootstrap. Keystone.jar registers no listener of its own — see {@code CLAUDE.md}.
+	 */
+	public void registerListeners(JavaPlugin owner) {
+		Bukkit.getPluginManager().registerEvents(new MenuListener(this, owner, cooldowns), owner);
+	}
+
+	/** Reload cycle: close every menu this service is tracking with {@link CloseReason#RELOAD}. */
+	@Override
+	public void onPreClear() {
+		tracker.closeAll(CloseReason.RELOAD);
+	}
+
+	/** Plugin disabling: close every menu this service is tracking with {@link CloseReason#PLUGIN_DISABLE}. */
+	@Override
+	public void onShutdown() {
+		tracker.closeAll(CloseReason.PLUGIN_DISABLE);
+	}
+}
