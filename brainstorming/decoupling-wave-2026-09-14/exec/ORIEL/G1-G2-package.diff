+package org.luckyraven.oriel.chest;
+
+import be.seeseemelk.mockbukkit.MockBukkit;
+import be.seeseemelk.mockbukkit.ServerMock;
+import be.seeseemelk.mockbukkit.entity.PlayerMock;
+import org.bukkit.ChatColor;
+import org.bukkit.Material;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.ItemMeta;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.luckyraven.oriel.chest.component.ItemComponent;
+import org.luckyraven.oriel.chest.component.PaginatedListComponent;
+import org.luckyraven.keystone.placeholder.PlaceholderProvider;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+/**
+ * G2 confirmation spike (WS2-inventory-oriel.md §3 finding C4): "placeholder resolution for a consumer's
+ * in-process placeholder service" and "row-scoped {@code %member_*%}/{@code %ally_*%} tokens" are NOT two gaps
+ * needing new Oriel primitives — the seam already exists on both counts, this test proves it end to end so the
+ * claim isn't just asserted in a plan document.
+ *
+ * <p><b>Menu-level tokens</b> (e.g. {@code %money_symbol%}): any {@link PlaceholderProvider} — PAPI-backed or a
+ * consumer's own in-process resolver, it makes no difference to Oriel — plugs into
+ * {@link ChestMenuBuilder#placeholders(PlaceholderProvider)} and resolves at render time, same as every other
+ * {@code %...%} token.
+ *
+ * <p><b>Row-scoped tokens</b> (e.g. {@code %member_name%}/{@code %member_rank%}, different per paginated list
+ * entry): {@link PaginatedListComponent#from} takes a {@code Function<RenderContext, List<ItemStack>>} that
+ * returns ALREADY-BUILT {@link ItemStack}s — the consumer's own source function (Gangland's
+ * {@code GangItemSourceProvider}, per the plan) resolves each row's values into the stack's name/lore itself,
+ * the same way it would build any other item. No PAPI-style expansion could resolve these anyway — a
+ * player-scoped placeholder call has no way to know which row a slot is rendering. This is why the plan (§3
+ * finding C4) landed on "no new Oriel ask for this row": there is nothing to build, only to prove it composes.
+ */
+final class PlaceholderResolutionAndRowScopedSourceTest {
+
+	private ServerMock server;
+
+	@BeforeEach
+	void start() {
+		server = MockBukkit.mock();
+	}
+
+	@AfterEach
+	void stop() {
+		MockBukkit.unmock();
+	}
+
+	private static String displayName(ChestMenu menu, int slot) {
+		ItemStack stack = menu.bukkitInventory().getItem(slot);
+		assertNotNull(stack, () -> "expected an item at slot " + slot);
+		ItemMeta meta = stack.getItemMeta();
+		assertNotNull(meta);
+		return ChatColor.stripColor(meta.getDisplayName());
+	}
+
+	private static List<String> lore(ChestMenu menu, int slot) {
+		ItemStack stack = menu.bukkitInventory().getItem(slot);
+		assertNotNull(stack, () -> "expected an item at slot " + slot);
+		ItemMeta meta = stack.getItemMeta();
+		assertNotNull(meta);
+		List<String> raw = meta.getLore()warning: in the working copy of 'menu-inventories/chest/src/test/java/org/luckyraven/oriel/chest/component/PriceGridComponentTest.java', LF will be replaced by CRLF the next time Git touches it
;
+		assertNotNull(raw, () -> "expected lore at slot " + slot);
+		return raw.stream().map(ChatColor::stripColor).toList();
+	}
+
+	/** A per-row domain record, standing in for Gangland's {@code Member}. */
+	private record Member(String name, String rank, int contribution) {
+	}
+
+	/** Mirrors what a consumer's own source-provider rewrite (e.g. {@code GangItemSourceProvider}) would do:
+	 *  build a fully-resolved {@link ItemStack} per row, baking the row's own field values directly into the
+	 *  name/lore — no Oriel placeholder call involved for these row-scoped values at all. {@link PaginatedListComponent#from}
+	 *  places the returned stack verbatim (unlike {@link ItemComponent}, it does no {@code &}-code translation of
+	 *  its own), so a real consumer would run its own strings through {@code ChatUtil.color(...)} first — skipped
+	 *  here since this test asserts row-value substitution, not color translation. */
+	private static ItemStack itemFor(Member member) {
+		ItemStack stack = new ItemStack(Material.PLAYER_HEAD);
+		ItemMeta  meta  = stack.getItemMeta();
+		meta.setDisplayName(member.name());
+		meta.setLore(List.of("Rank: " + member.rank(), "Contribution: " + member.contribution()));
+		stack.setItemMeta(meta);
+		return stack;
+	}
+
+	@Test
+	void customInProcessPlaceholderProviderResolvesAMenuLevelToken() {
+		// Simulates Gangland's own PlaceholderService (not PAPI) as the ChestMenuBuilder's placeholders(...) —
+		// the seam is a plain functional interface, so any resolver plugs in identically.
+		PlaceholderProvider inProcessMoneySymbol = (player, raw) -> raw.replace("%money_symbol%", "$");
+
+		ChestMenu menu = ChestMenu.builder()
+		                          .rows(1)
+		                          .placeholders(inProcessMoneySymbol)
+		                          .slot(0, ItemComponent.of(Material.GOLD_INGOT).name("&6Balance: %money_symbol%100"))
+		                          .build();
+
+		PlayerMock player = server.addPlayer();
+		menu.open(player);
+
+		assertEquals("Balance: $100", displayName(menu, 0));
+	}
+
+	@Test
+	void rowScopedValuesComeFromTheSourceFunctionNotAPlaceholderCall() {
+		List<Member> roster = List.of(
+				new Member("Alice", "Leader", 500),
+				new Member("Bob", "Member", 120)
+		);
+
+		// No PlaceholderProvider is involved in building these rows — the source function resolves row-scoped
+		// data itself, exactly as GangItemSourceProvider would. Also attach an unrelated menu-level placeholder
+		// to prove the two mechanisms compose without interfering with each other.
+		PlaceholderProvider inProcessMoneySymbol = (player, raw) -> raw.replace("%money_symbol%", "$");
+		PaginatedListComponent members = PaginatedListComponent.from(
+				ctx -> roster.stream().map(PlaceholderResolutionAndRowScopedSourceTest::itemFor).toList());
+
+		ChestMenu menu = ChestMenu.builder()
+		                          .rows(3)
+		                          .placeholders(inProcessMoneySymbol)
+		                          .region(1, 1, 0, 8, members)
+		                          .slot(0, ItemComponent.of(Material.GOLD_INGOT).name("&6Bank: %money_symbol%50"))
+		                          .build();
+
+		PlayerMock player = server.addPlayer();
+		menu.open(player);
+
+		// Menu-level token still resolves via the in-process provider.
+		assertEquals("Bank: $50", displayName(menu, 0));
+
+		// Row 1 spans slots 9..17 (region rows [1,1], cols [0,8]) — Alice at 9, Bob at 10, per source order.
+		assertEquals("Alice", displayName(menu, 9));
+		assertEquals(List.of("Rank: Leader", "Contribution: 500"), lore(menu, 9));
+		assertEquals("Bob", displayName(menu, 10));
+		assertEquals(List.of("Rank: Member", "Contribution: 120"), lore(menu, 10));
+	}
+}
