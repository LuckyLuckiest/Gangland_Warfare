@@ -0,0 +1,121 @@
+package org.luckyraven.oriel.chest.component;
+
+import be.seeseemelk.mockbukkit.MockBukkit;
+import be.seeseemelk.mockbukkit.ServerMock;
+import be.seeseemelk.mockbukkit.entity.PlayerMock;
+import org.bukkit.Material;
+import org.bukkit.event.inventory.ClickType;
+import org.bukkit.event.inventory.InventoryAction;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryType;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.luckyraven.keystone.cooldown.InMemoryCooldownService;
+import org.luckyraven.oriel.chest.ChestMenu;
+import org.luckyraven.oriel.chest.ChestMenuBuilder;
+import org.luckyraven.oriel.chest.listener.ChestMenuClickListener;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+/**
+ * Covers the mirror-outward house rule ({@code centerSlot - distance} / {@code + distance}, biggest step nearest
+ * the center) and the click -> clamp -> rerender cycle.
+ */
+final class PriceGridComponentTest {
+
+	private static final int CENTER_SLOT = 22; // row 2 of a 3-row/27-slot menu
+
+	private ServerMock server;
+	private Plugin     plugin;
+
+	@BeforeEach
+	void start() {
+		server = MockBukkit.mock();
+		plugin = MockBukkit.createMockPlugin();
+		server.getPluginManager()
+		      .registerEvents(new ChestMenuClickListener((JavaPlugin) plugin, new InMemoryCooldownService()), plugin);
+	}
+
+	@AfterEach
+	void stop() {
+		MockBukkit.unmock();
+	}
+
+	@Test
+	void mirroredSlotLayoutMatchesHouseRule() {
+		PlayerMock player = server.addPlayer();
+		AtomicLong amount = new AtomicLong(1);
+		ChestMenu  menu   = buildGrid(amount, 1, 10_000);
+		menu.open(player);
+
+		// Left side: biggest step nearest the center, smallest at the edge.
+		assertName(menu, CENTER_SLOT - 1, "-100");
+		assertName(menu, CENTER_SLOT - 2, "-10");
+		assertName(menu, CENTER_SLOT - 3, "-1");
+		// Mirrored on the right.
+		assertName(menu, CENTER_SLOT + 1, "+100");
+		assertName(menu, CENTER_SLOT + 2, "+10");
+		assertName(menu, CENTER_SLOT + 3, "+1");
+		// Center preview, nothing else at that slot.
+		assertName(menu, CENTER_SLOT, "Amount:1");
+	}
+
+	@Test
+	void clickingStepButtonUpdatesValueAndRerendersPreviewInPlace() {
+		PlayerMock player = server.addPlayer();
+		AtomicLong amount = new AtomicLong(1);
+		ChestMenu  menu   = buildGrid(amount, 1, 150);
+		menu.open(player);
+
+		fireClick(player, CENTER_SLOT + 1, ClickType.LEFT); // "+100" button
+
+		assertEquals(101L, amount.get());
+		assertName(menu, CENTER_SLOT, "Amount:101"); // proves the rerender repainted the preview in place
+	}
+
+	@Test
+	void clickingStepButtonClampsAtBoundWithoutOvershootOrThrow() {
+		PlayerMock player = server.addPlayer();
+		AtomicLong amount = new AtomicLong(1);
+		ChestMenu  menu   = buildGrid(amount, 1, 50);
+		menu.open(player);
+
+		fireClick(player, CENTER_SLOT + 1, ClickType.LEFT); // "+100" would overshoot max=50
+
+		assertEquals(50L, amount.get());
+		assertName(menu, CENTER_SLOT, "Amount:50");
+
+		fireClick(player, CENTER_SLOT + 1, ClickType.LEFT); // click again at the bound: stays clamped, no throw
+
+		assertEquals(50L, amount.get());
+	}
+
+	private ChestMenu buildGrid(AtomicLong amount, long min, long max) {
+		ChestMenuBuilder builder = ChestMenu.builder().rows(3);
+		PriceGridComponent.install(builder, CENTER_SLOT, new long[]{1, 10, 100},
+		                           amount::get, min, max, amount::set,
+		                           current -> ItemComponent.of(Material.EMERALD).name("Amount:" + current),
+		                           (magnitude, positive) -> ItemComponent.of(positive ? Material.LIME_DYE : Material.RED_DYE)
+		                                                                 .name((positive ? "+" : "-") + magnitude));
+		return builder.build();
+	}
+
+	private void assertName(ChestMenu menu, int slot, String expectedDisplayName) {
+		ItemStack item = menu.bukkitInventory().getItem(slot);
+		assertNotNull(item, "expected an item at slot " + slot);
+		assertEquals(expectedDisplayName, item.getItemMeta().getDisplayName());
+	}
+
+	private void fireClick(PlayerMock player, int slot, ClickType type) {
+		server.getPluginManager()
+		      .callEvent(new InventoryClickEvent(player.getOpenInventory(), InventoryType.SlotType.CONTAINER, slot,
+		                                         type, InventoryAction.NOTHING));
+	}
+}
