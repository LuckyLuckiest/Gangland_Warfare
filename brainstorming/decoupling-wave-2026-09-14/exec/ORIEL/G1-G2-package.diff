+package org.luckyraven.oriel.chest.component;
+
+import org.luckyraven.oriel.chest.ChestMenuBuilder;
+import org.luckyraven.oriel.core.component.Component;
+import org.luckyraven.oriel.core.component.RenderContext;
+import org.luckyraven.oriel.core.component.SlotView;
+
+import java.util.function.LongConsumer;
+import java.util.function.LongFunction;
+import java.util.function.LongSupplier;
+import java.util.function.Supplier;
+
+/**
+ * Installs a "price-entry grid" onto a {@link ChestMenuBuilder}: a center preview item flanked by mirrored +/- step
+ * buttons, for buy-quantity / price-editor / bid-amount style UIs.
+ *
+ * <p><b>House rule — mirror OUTWARD.</b> Paired +/- step buttons must mirror outward from the center: the BIGGEST
+ * step sits immediately adjacent to the center item on both sides, the SMALLEST step sits at the far edges.
+ * Magnitude increases as you approach the center from either edge. For ascending steps {@code [1, 10, 100]} and a
+ * center slot, the row (left to right) is:
+ *
+ * <pre>
+ * -1, -10, -100, [center], +100, +10, +1
+ * </pre>
+ *
+ * This is NOT the "smallest near center, biggest at edges" convention some UIs use — it is the opposite, on
+ * purpose. Consumer-side price/quantity pickers should install this instead of hand-rolling their own mirrored
+ * button ring.
+ *
+ * <pre>{@code
+ * ChestMenuBuilder builder = ChestMenu.builder();
+ * PriceGridComponent.install(builder, 22, new long[]{1, 10, 100},
+ *     () -> currentAmount.get(), 1, 10_000, next -> currentAmount.set(next),
+ *     amount -> ItemComponent.of(Material.EMERALD).name("&aAmount: " + amount),
+ *     (delta, positive) -> ItemComponent.of(positive ? Material.LIME_DYE : Material.RED_DYE)
+ *         .name((positive ? "&a+" : "&c-") + delta));
+ * }</pre>
+ */
+public final class PriceGridComponent {
+
+	PriceGridComponent() {
+	}
+
+	/**
+	 * Builds the item shown for one step button, given the step's magnitude (always positive) and whether it is
+	 * the increasing (+) or decreasing (-) side of the grid.
+	 */
+	@FunctionalInterface
+	public interface StepItemFactory {
+		ItemComponent item(long magnitude, boolean positive);
+	}
+
+	/**
+	 * Install the mirrored row onto {@code builder}. {@code steps} must be ascending and non-empty; the biggest
+	 * step lands nearest {@code centerSlot}, the smallest at the outer edge, per the house rule above.
+	 *
+	 * <p>Clicking a step button re-reads {@code currentValue} at click time (never a build-time snapshot), applies
+	 * the signed delta, clamps to {@code [min, max]}, writes back through {@code onChange}, then calls
+	 * {@link org.luckyraven.oriel.core.click.ClickContext#rerender()} so the preview and every button repaint.
+	 *
+	 * @param builder        the menu builder to install into
+	 * @param centerSlot     slot index of the preview item; step buttons are placed at
+	 *                       {@code centerSlot - distance} / {@code centerSlot + distance}
+	 * @param steps          ascending step magnitudes, e.g. {@code [1, 10, 100]}
+	 * @param currentValue   reads the live current value
+	 * @param min            inclusive clamp lower bound
+	 * @param max            inclusive clamp upper bound
+	 * @param onChange       writes the clamped new value back
+	 * @param previewFactory builds the center preview item for a given current value
+	 * @param stepFactory    builds a step button's item for a given magnitude/direction
+	 */
+	public static void install(ChestMenuBuilder builder, int centerSlot, long[] steps, LongSupplier currentValue,
+	                           long min, long max, LongConsumer onChange,
+	                           LongFunction<ItemComponent> previewFactory, StepItemFactory stepFactory) {
+		if (steps.length == 0) {
+			throw new IllegalArgumentException("steps must not be empty");
+		}
+
+		builder.slot(centerSlot, previewComponent(currentValue, previewFactory));
+
+		for (int i = 0; i < steps.length; i++) {
+			long magnitude = steps[steps.length - 1 - i]; // biggest first: nearest the center
+			int  distance  = i + 1;
+			builder.slot(centerSlot - distance,
+			             stepComponent(magnitude, false, currentValue, min, max, onChange, stepFactory));
+			builder.slot(centerSlot + distance,
+			             stepComponent(magnitude, true, currentValue, min, max, onChange, stepFactory));
+		}
+	}
+
+	private static Component<?> previewComponent(LongSupplier currentValue, LongFunction<ItemComponent> previewFactory) {
+		return new LiveComponent(() -> previewFactory.apply(currentValue.getAsLong()));
+	}
+
+	private static Component<?> stepComponent(long magnitude, boolean positive, LongSupplier currentValue, long min,
+	                                          long max, LongConsumer onChange, StepItemFactory stepFactory) {
+		return new LiveComponent(() -> stepFactory.item(magnitude, positive).onLeftClick(ctx -> {
+			long current = currentValue.getAsLong();
+			long next    = positive ? current + magnitude : current - magnitude;
+			next = Math.max(min, Math.min(max, next));
+			onChange.accept(next);
+			ctx.rerender();
+		}));
+	}
+
+	/**
+	 * Internal: rebuilds its {@link ItemComponent} from {@code factory} on every render pass instead of rendering a
+	 * snapshot captured at install time — this is what makes the preview (and every button, in case its label
+	 * depends on the value) repaint correctly after {@link org.luckyraven.oriel.core.click.ClickContext#rerender()}.
+	 */
+	private static final class LiveComponent implements Component<LiveComponent> {
+
+		private final Supplier<ItemComponent> factory;
+
+		private LiveComponent(Supplier<ItemComponent> factory) {
+			this.factory = factory;
+		}
+
+		@Override
+		public void renderInto(SlotView view, RenderContext ctx) {
+			factory.get().renderInto(view, ctx);
+		}
+	}
+}
