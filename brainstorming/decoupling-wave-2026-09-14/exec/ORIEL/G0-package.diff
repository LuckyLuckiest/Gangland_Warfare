+	/**
+	 * Convenience factory for a host plugin that only needs Oriel's default wiring — the 3 arguments every known
+	 * consumer (Gangland and friends) actually has to hand at bean-construction time. The full constructor takes 17
+	 * arguments; this factory resolves the 9 that Oriel publishes on Bukkit's {@link ServicesManager}
+	 * ({@link MenuRegistry}, {@link ActionRegistry}, {@link SourceProviderRegistry}, {@link FilterRegistry},
+	 * {@link SortRegistry}, {@link SearchMatcherRegistry}, {@link ItemProviderRegistry},
+	 * {@link MaterialSourceRegistry}, {@link ComponentRegistry}) and builds the remaining 4 itself:
+	 *
+	 * <ul>
+	 *   <li>{@link PaginatedControlRegistry} — a fresh instance private to the returned service. It only needs to
+	 *       track {@code plugin}'s own paginated menus, so it is never shared with Oriel's own copy.</li>
+	 *   <li>{@link RequirementRegistry} — a fresh {@link InMemoryRequirementRegistry}, the same default every other
+	 *       Oriel consumer gets.</li>
+	 *   <li>{@link MenuCommandRegistrar} — constructed against <b>{@code plugin}</b>, not Oriel:
+	 *       {@code open.command}/{@code open.commands} aliases this service registers belong to the
+	 *       <em>calling</em> plugin, appear on that plugin's help page, and are torn down when that plugin (not
+	 *       Oriel) disables.</li>
+	 *   <li>{@link CooldownService} — <b>Keystone's contract type, not Oriel's</b>
+	 *       ({@code org.luckyraven.keystone.cooldown.CooldownService} in {@code keystone-common}). Oriel does not
+	 *       publish one on the {@code ServicesManager}: every Keystone-based plugin is expected to own its own bean
+	 *       (Keystone's {@code getting-started.md}: {@code @Bean CooldownService cooldowns() { return new
+	 *       InMemoryCooldownService(); }}). This factory installs a fresh {@link InMemoryCooldownService} so
+	 *       {@code cooldown:} requirements in {@code plugin}'s own menus work out of the box. If {@code plugin}
+	 *       already has its own {@code CooldownService} bean (for example a persistent one backed by its own
+	 *       database), skip this factory and call the 17-arg constructor directly instead — otherwise Oriel silently
+	 *       allocates a second, unrelated in-memory one.</li>
+	 * </ul>
+	 *
+	 * <p>{@code allow_elevated_actions} (the {@code op:}/{@code permission:} action gate) defaults to
+	 * <b>disabled</b> here, matching {@link ActionParser#setElevatedActionsGate}'s own null-gate default. A
+	 * consumer that wants its menus to run elevated actions must call the 17-arg constructor with its own
+	 * {@link java.util.function.BooleanSupplier}.
+	 *
+	 * @param plugin       the consumer plugin. Owns the {@link MenuCommandRegistrar} registrations built from this
+	 *                     service's {@code open:} commands (see above) — <b>not</b> Oriel.
+	 * @param fileManager  {@code plugin}'s own {@link FileManager}; this service's {@code plugins/<plugin>/menus/}
+	 *                     folder is seeded and reloaded through it, exactly like any other {@link FolderLoader}.
+	 * @param placeholders {@code plugin}'s {@link PlaceholderProvider} chain for {@code %...%} tokens in menu YAML.
+	 * @return a fully wired {@link warning: in the working copy of 'menu-data/config/src/test/java/org/luckyraven/oriel/config/MenuConfigServiceForConsumerTest.java', LF will be replaced by CRLF the next time Git touches it
MenuConfigService}, ready to be handed to {@code fileManager} the same way the
+	 *         17-arg constructor's result would be.
+	 * @throws IllegalStateException if Oriel has not published its registries on the {@link ServicesManager} yet —
+	 *                                call this only after Oriel has enabled. A hard {@code depend: Oriel} in
+	 *                                {@code plugin.yml} guarantees that for any bean built during or after the
+	 *                                consumer's own {@code onEnable}.
+	 */
+	public static MenuConfigService forConsumer(JavaPlugin plugin, FileManager fileManager,
+	                                            PlaceholderProvider placeholders) {
+		ServicesManager services = plugin.getServer().getServicesManager();
+		MenuRegistry    registry = requireService(services, MenuRegistry.class);
+		return new MenuConfigService(plugin, registry, fileManager, placeholders,
+		                             requireService(services, ActionRegistry.class),
+		                             requireService(services, SourceProviderRegistry.class),
+		                             requireService(services, FilterRegistry.class),
+		                             requireService(services, SortRegistry.class),
+		                             requireService(services, SearchMatcherRegistry.class),
+		                             requireService(services, ItemProviderRegistry.class),
+		                             requireService(services, MaterialSourceRegistry.class),
+		                             new PaginatedControlRegistry(),
+		                             requireService(services, ComponentRegistry.class),
+		                             new MenuCommandRegistrar(plugin, registry),
+		                             new InMemoryRequirementRegistry(), new InMemoryCooldownService(),
+		                             () -> false);
+	}
+
+	private static <T> T requireService(ServicesManager services, Class<T> type) {
+		T bean = services.load(type);
+		if (bean == null) {
+			throw new IllegalStateException("Oriel has not published " + type.getSimpleName() + " on the " +
+			                                "ServicesManager yet — MenuConfigService.forConsumer(...) must run " +
+			                                "after Oriel's plugin has enabled (a hard `depend: Oriel` in " +
+			                                "plugin.yml guarantees this for beans built during or after onEnable).");
+		}
+		return bean;
+	}
