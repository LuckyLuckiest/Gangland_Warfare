+
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Coverage for {@link MenuConfigService#forConsumer(JavaPlugin, FileManager, PlaceholderProvider)} — the 3-arg
+ * factory a host plugin (e.g. Gangland's {@code OrielMenuConfig} bean) calls once Oriel's plugin has published its
+ * registries on the {@link ServicesManager}, in place of hand-assembling the full 17-arg constructor.
+ */
+final class MenuConfigServiceForConsumerTest {
+
+	private static final String DEMO = """
+			type: chest
+			title: "&6Consumer Demo"
+			rows: 1
+			open:
+			  command: demo
+			slots:
+			  0:
+			    item: EMERALD
+			""";
+
+	private ServerMock server;
+	private JavaPlugin plugin;
+
+	@BeforeEach
+	void start() {
+		server = MockBukkit.mock();
+		plugin = MockBukkit.createMockPlugin();
+	}
+
+	@AfterEach
+	void stop() {
+		MockBukkit.unmock();
+	}
+
+	private void publishOrielRegistries() {
+		ServicesManager services = server.getServicesManager();
+		services.register(MenuRegistry.class, new InMemoryMenuRegistry(), plugin, ServicePriority.Normal);
+		services.register(ActionRegistry.class, new InMemoryActionRegistry(), plugin, ServicePriority.Normal);
+		services.register(SourceProviderRegistry.class, new InMemorySourceProviderRegistry(), plugin,
+		                  ServicePriority.Normal);
+		services.register(FilterRegistry.class, new InMemoryFilterRegistry(), plugin, ServicePriority.Normal);
+		services.register(SortRegistry.class, new InMemorySortRegistry(), plugin, ServicePriority.Normal);
+		services.register(SearchMatcherRegistry.class, new InMemorySearchMatcherRegistry(), plugin,
+		                  ServicePriority.Normal);
+		services.register(ItemProviderRegistry.class, new InMemoryItemProviderRegistry(), plugin,
+		                  ServicePriority.Normal);
+		services.register(MaterialSourceRegistry.class, new InMemoryMaterialSourceRegistry(), plugin,
+		                  ServicePriority.Normal);
+		services.register(ComponentRegistry.class, new InMemoryComponentRegistry(), plugin, ServicePriority.Normal);
+	}
+
+	@Test
+	void resolvesPublishedRegistriesAndLoadsAConsumerMenu() throws IOException {
+		publishOrielRegistries();
+
+		Path menusDir = plugin.getDataFolder().toPath().resolve("menus");
+		Files.createDirectories(menusDir);
+		Files.writeString(menusDir.resolve("demo.yml"), DEMO);
+
+		PlaceholderProvider passthrough = (p, raw) -> raw;
+		MenuConfigService   menus       = MenuConfigService.forConsumer(plugin, new FileManager(plugin),
+		                                                                passthrough);
+		menus.onInitialize(true);
+
+		assertTrue(menus.ownedNames().contains("demo"), "forConsumer's service should load the consumer's own menu");
+		assertNotNull(server.getCommandMap().getCommand("demo"), "the open.command alias should be registered");
+	}
+
+	@Test
+	void failsFastWithANamedServiceWhenOrielHasNotPublishedYet() {
+		// None of Oriel's registries are registered on the ServicesManager — simulates calling forConsumer
+		// before Oriel has enabled (or without Oriel installed at all).
+		PlaceholderProvider passthrough = (p, raw) -> raw;
+		IllegalStateException thrown = assertThrows(IllegalStateExceptiwarning: in the working copy of 'menu-data/config/src/test/resources/menus/chest_paginated_filter.yml', LF will be replaced by CRLF the next time Git touches it
on.class,
+		                                            () -> MenuConfigService.forConsumer(plugin,
+		                                                                                new FileManager(plugin),
+		                                                                                passthrough));
+		assertTrue(thrown.getMessage().contains("MenuRegistry"),
+		           () -> "expected the failure to name the missing service: " + thrown.getMessage());
+	}
+}
