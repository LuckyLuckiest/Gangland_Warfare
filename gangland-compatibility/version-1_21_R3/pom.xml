<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland-compatibility</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>version-1_21_R3</artifactId>

    <properties>
        <spigot.version>1.21.4-R0.1-SNAPSHOT</spigot.version>
    </properties>

    <dependencies>
        <!-- NMS server internals (mojang-mapped for compilation; remapped at package time) -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot</artifactId>
            <version>${spigot.version}</version>
            <classifier>remapped-mojang</classifier>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-impl</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Remap executions and configuration inherited from gangland-compatibility -->
            <plugin>
                <groupId>net.md-5</groupId>
                <artifactId>specialsource-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
