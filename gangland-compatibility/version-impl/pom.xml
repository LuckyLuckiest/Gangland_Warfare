<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland-compatibility</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>version-impl</artifactId>

    <name>Version Handler</name>

    <dependencies>
        <!-- Keystone shared infrastructure (provided by Keystone.jar at runtime; never shaded).
             Declared directly: provided scope is not transitive, so it cannot arrive via gangland-core. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <!-- Spigot Build -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.viaversion</groupId>
            <artifactId>viaversion-api</artifactId>
        </dependency>
    </dependencies>

</project>
