<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 configuration used only during test execution.
    Routes all output to the console at WARN level so test output stays clean,
    while still surfacing any unexpected warnings or errors from the persistence layer.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[TEST][%level] %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
