<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland_warfare</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>gangland-api</artifactId>

    <name>Gangland API</name>
    <description>Gangland Warfare module API — the only host artifact a runtime module compiles against.</description>

    <dependencies>
        <!-- Spigot Build -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Host libraries re-exported at compile scope: a runtime module gets all of them
             transitively from the single gangland-api dependency in its own pom.
             WS5 G0 (B6): the gangland-domain re-export is gone — the 4 api files that used to need gang.* types
             (WaypointTeleport, TeleportEvent, UserLevelUpEvent, MoneyAspect) only ever needed the identity slice
             (User/Level/UserLevelUpEvent), which is now gangland-core, already listed below. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-item</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>sign-api</artifactId>
        </dependency>

        <!-- Keystone (provided via dependencyManagement — never shaded, comes from Keystone.jar) -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-command</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-item</artifactId>
        </dependency>
        <!-- keystone.economy lives in keystone-hooks; there is no keystone-economy artifact -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-hooks</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-npc</artifactId>
        </dependency>
        <!-- WS4 G1a: keystone-shop, B2 — provided here (not re-exported at compile scope like shop-api was). -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-shop</artifactId>
        </dependency>

        <!-- XSeries -->
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
        </dependency>

        <!-- NBTAPI -->
        <dependency>
            <groupId>de.tr7zw</groupId>
            <artifactId>item-nbt-api-plugin</artifactId>
        </dependency>
    </dependencies>

</project>
