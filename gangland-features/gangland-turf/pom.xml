<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland-features</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gangland-turf</artifactId>

    <name>Gangland Turf</name>

    <dependencies>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-item</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-command</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-module</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-npc</artifactId>
        </dependency>
        <!-- The moved turf-NPC managers (TurfPowerupManager, TurfDefenderDeployer) spawn through the civilians
             module's CivilianSpawnManager/CivilianService/CivilianNpc, exactly like cops-n-crooks does (group I;
             not named by T-I1's own task text, found necessary to compile the moved code — see status table). -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-civilians</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Spigot Build -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Local dependencies -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-hooks</artifactId>
        </dependency>
        <!-- WS5 G1-G3: gangland-domain is empty (Gang/GangLookupContract/... moved into the gang module);
             pointing this at gangland-gang instead is a pure retarget, no source change (package names for these
             types stayed identical). provided, matching every other module-to-module dependency (e.g.
             cops-n-crooks -> turf/civilians) — gang's classes come from Keystone's ModuleLoader at runtime, not
             shaded in. module.yml's Depends now lists gang alongside civilians. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-gang</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Moved turf-NPC views (TurfPowerupFlow/View classes, group I) need InventoryHandler/MultiPanelInventory. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-inventory</artifactId>
        </dependency>

        <!-- Citizens dependency (moved turf-NPC code, group I) -->
        <dependency>
            <groupId>net.citizensnpcs</groupId>
            <artifactId>citizens-main</artifactId>
        </dependency>

        <!-- XSeries dependency -->
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
        </dependency>

        <!-- NBTAPI -->
        <dependency>
            <groupId>de.tr7zw</groupId>
            <artifactId>item-nbt-api-plugin</artifactId>
        </dependency>

        <!-- The host API — the only host artifact a runtime module compiles against, so the compiler enforces
             the contract. Provided: at runtime this module is loaded from plugins/Gangland_Warfare/modules/ by
             Keystone's ModuleLoader, whose parent is the host plugin's classloader, so every api class resolves
             from the shaded core jar. Dependency direction is module -> api; the host never names a turf type. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Shared test fixtures (testsupport.CitizensBlindScan / ConfigurationConstructorScan) -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
