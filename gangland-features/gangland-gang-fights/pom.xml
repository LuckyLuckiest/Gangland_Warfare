<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland-features</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gangland-gang-fights</artifactId>

    <name>Gangland Gang Fights</name>

    <dependencies>
        <!-- Spigot Build -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Keystone framework plumbing, declared directly like every runtime module. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-command</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-module</artifactId>
        </dependency>

        <!-- The gang module (module.yml Depends: [gang]): provided, its classes come from Keystone's ModuleLoader
             at runtime, exactly as for gangland-mail. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-gang</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The host API: the only host artifact a runtime module compiles against. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
