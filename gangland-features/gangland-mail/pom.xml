<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.luckyraven</groupId>
        <artifactId>gangland-features</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gangland-mail</artifactId>

    <name>Gangland Mail</name>

    <dependencies>
        <!-- Spigot Build -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Local dependencies -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-core</artifactId>
        </dependency>
        <!-- WS5 G1-G3: gangland-domain is empty (Gang/GangManager/Member/Rank/... moved into the gang module);
             pointing this at gangland-gang instead is a pure retarget, no source change (package names stayed
             identical). provided, matching every other module-to-module dependency — gang's classes come from
             Keystone's ModuleLoader at runtime, not shaded in (the old unscoped/compile entry was itself already
             inconsistent with that convention). module.yml now declares Depends: [gang]. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-gang</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-command</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-module</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-hooks</artifactId>
        </dependency>
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>keystone-item</artifactId>
        </dependency>

        <!-- The host API — the only host artifact a runtime module compiles against, so the compiler enforces the
             contract. Provided: at runtime this module is loaded from plugins/Gangland_Warfare/modules/ by
             Keystone's ModuleLoader, whose parent is the host plugin's classloader, so every api class resolves
             from the shaded core jar. Dependency direction is module -> api; the host never names a module type. -->
        <dependency>
            <groupId>org.luckyraven</groupId>
            <artifactId>gangland-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
