<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.luckyraven</groupId>
        <artifactId>gangland_warfare</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gangland-ui</artifactId>
    <packaging>pom</packaging>

    <name>Gangland UI</name>

    <modules>
        <module>hologram-api</module>
        <module>inventory-api</module>
        <module>scoreboard-api</module>
        <module>sign-api</module>
        <module>lootchest-api</module>
        <module>shop-api</module>
    </modules>

    <dependencies>
        <!-- Every UI module compiles against the Spigot API at provided scope. -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
