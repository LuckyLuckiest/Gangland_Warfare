<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status="INFO">

    <Properties>
        <Property name="projectName">@project.name@</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%level]: [${projectName}] [%logger{1}] %msg%n%ex"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="debug">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>